@model List<TempestSushi.Application.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Productos";
}

<style>
    .prod-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
    }

    .prod-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: #1a3a6e;
        letter-spacing: 1px;
        margin: 0;
    }

    .prod-badge {
        background: #1a3a6e;
        color: #4fa8e8;
        font-size: .7rem;
        letter-spacing: 2px;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .prod-card {
        background: #fff;
        border: 1.5px solid #d0e8f8;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(26,58,110,0.07);
        transition: transform .2s, box-shadow .2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        opacity: 0;
    }

        .prod-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(26,58,110,0.13);
        }

    .prod-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .prod-img-placeholder {
        width: 100%;
        height: 200px;
        background: #e8f4fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
    }

    .prod-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .prod-nombre {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: #1a3a6e;
        margin-bottom: 6px;
    }

    .prod-cat {
        font-size: .8rem;
        color: #4fa8e8;
        letter-spacing: 1px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .prod-precio {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a3a6e;
        margin-bottom: 1rem;
    }

    .btn-ver {
        display: block;
        text-align: center;
        background: #1a3a6e;
        color: #fff !important;
        border-radius: 8px;
        padding: 8px;
        font-family: 'Rajdhani', sans-serif;
        font-size: .95rem;
        letter-spacing: 1px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s;
        margin-top: auto;
    }

        .btn-ver:hover {
            background: #c0392b;
        }
</style>

<div class="prod-header" id="prodHeader">
    @if (ViewBag.NotificationMessage != null)
    {
        <div class="alert alert-success">@ViewBag.NotificationMessage</div>
    }

    <div class="mb-4">
        <a asp-action="Crear" class="btn-ver" style="display:inline-block; width:auto; padding:10px 24px;">+ Nuevo producto</a>
    </div>
</div>

<div class="row g-4" id="prodGrid">
    @foreach (var producto in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="prod-card">
                @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                {
                    <img src="@producto.ImagenUrl" class="prod-img" alt="@producto.Nombre" />
                }
                else
                {
                    <div class="prod-img-placeholder">🍱</div>
                }
                <div class="prod-body">
                    <div class="prod-nombre">@producto.Nombre</div>
                    <div class="prod-cat">@producto.Categoria</div>
                    <div class="prod-precio">₡@producto.Precio.ToString("N2")</div>
                    <a asp-controller="Producto" asp-action="Detalle" asp-route-id="@producto.IdProducto"
                       class="btn-ver">Ver detalle</a>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
<script>
    anime({ targets: '#prodHeader', translateY: [-20, 0], opacity: [0, 1], duration: 600, easing: 'easeOutExpo' });
    anime({ targets: '.prod-card', translateY: [30, 0], opacity: [0, 1], duration: 500, delay: anime.stagger(100, { start: 200 }), easing: 'easeOutExpo' });
</script>
