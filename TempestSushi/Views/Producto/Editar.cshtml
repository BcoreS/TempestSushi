@model TempestSushi.Application.DTOs.ProductoFormDto
@{
    ViewData["Title"] = "Editar Producto";
}

<style>
    .form-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
    }

    .form-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.9rem;
        font-weight: 700;
        color: #1a3a6e;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1.5px solid #d0e8f8;
        border-radius: 14px;
        padding: 2rem;
        box-shadow: 0 2px 16px rgba(26,58,110,0.07);
    }

    .form-label {
        font-weight: 600;
        color: #1a3a6e;
    }

    .ingredientes-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border: 1px solid #d0e8f8;
        border-radius: 10px;
        padding: 1rem;
        max-height: 220px;
        overflow-y: auto;
    }

    .ingrediente-chip {
        background: #e8f4fd;
        border-radius: 20px;
        padding: 6px 14px;
        cursor: pointer;
    }

    .btn-guardar {
        background: #1a3a6e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
    }

        .btn-guardar:hover {
            background: #c0392b;
            color: #fff;
        }

    .btn-cancelar {
        border: 1.5px solid #1a3a6e;
        color: #1a3a6e;
        border-radius: 8px;
        padding: 10px 28px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
    }

        .btn-cancelar:hover {
            background: #1a3a6e;
            color: #fff;
        }

    .img-preview-actual {
        max-width: 200px;
        border-radius: 10px;
        border: 1.5px solid #d0e8f8;
        margin-bottom: 8px;
    }
</style>

<div class="form-header">
    <h1 class="form-title">Editar Producto</h1>
</div>

<div class="form-card">
    <form asp-action="Editar" asp-route-id="@Model.IdProducto" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="IdProducto" />
        <input type="hidden" asp-for="ImagenActualUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Precio" class="form-label">Precio (₡)</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdCategoria" class="form-label">Categoría</label>
                <select asp-for="IdCategoria" class="form-select">
                    <option value="">-- Seleccione una categoría --</option>
                    @foreach (var cat in Model.CategoriasDisponibles)
                    {
                        <option value="@cat.IdCategoria">@cat.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ingredientes</label>
            <div class="ingredientes-grid">
                @foreach (var ing in Model.IngredientesDisponibles)
                {
                    var marcado = Model.IngredientesSeleccionados.Contains(ing.IdIngrediente);
                    <label class="ingrediente-chip">
                        <input type="checkbox" name="IngredientesSeleccionados" value="@ing.IdIngrediente" checked="@(marcado ? "checked" : null)" />
                        @ing.Nombre
                    </label>
                }
            </div>
            <span asp-validation-for="IngredientesSeleccionados" class="text-danger"></span>
        </div>

        <div class="mb-4">
            @if (!string.IsNullOrEmpty(Model.ImagenActualUrl))
            {
                <div><img src="@Model.ImagenActualUrl" class="img-preview-actual" alt="Imagen actual" /></div>
            }
            <label asp-for="Imagen" class="form-label">Cambiar imagen (opcional)</label>
            <input asp-for="Imagen" type="file" accept="image/*" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-guardar">Guardar cambios</button>
            <a asp-action="Detalle" asp-route-id="@Model.IdProducto" class="btn-cancelar">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}