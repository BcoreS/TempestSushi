@model TempestSushi.Application.DTOs.ProductoFormDto

@{
    ViewData["Title"] = "Editar Producto";
}

<style>
    .producto-form-page {
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 1rem 0 2rem;
    }

    /* ═══════════════════════════════════════
           HEADER
           ═══════════════════════════════════════ */

    .form-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
    }

    .form-title {
        margin: 0;
        font-family: 'Rajdhani', sans-serif;
        font-size: clamp(1.7rem, 4vw, 1.9rem);
        font-weight: 700;
        color: #1a3a6e;
        line-height: 1.2;
    }

    /* ═══════════════════════════════════════
           CARD
           ═══════════════════════════════════════ */

    .form-card {
        width: 100%;
        padding: 2rem;
        background: #ffffff;
        border: 1.5px solid #d0e8f8;
        border-radius: 14px;
        box-shadow: 0 2px 16px rgba(26, 58, 110, 0.07);
    }

        .form-card form {
            width: 100%;
            min-width: 0;
        }

    /* ═══════════════════════════════════════
           CAMPOS
           ═══════════════════════════════════════ */

    .form-label {
        margin-bottom: 0.4rem;
        color: #1a3a6e;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        width: 100%;
        min-width: 0;
        border: 1.5px solid #d0e8f8;
        border-radius: 8px;
        color: #1a3a6e;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #4fa8e8;
            box-shadow: 0 0 0 0.2rem rgba(79, 168, 232, 0.18);
        }

    textarea.form-control {
        resize: vertical;
    }

    .text-danger {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.82rem;
        line-height: 1.4;
    }

    /* ═══════════════════════════════════════
           INGREDIENTES
           ═══════════════════════════════════════ */

    .ingredientes-grid {
        display: grid;
        grid-template-columns: repeat( auto-fit, minmax(190px, 1fr) );
        gap: 10px;
        max-height: 240px;
        padding: 1rem;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid #d0e8f8;
        border-radius: 10px;
        background: #fafdff;
        scrollbar-width: thin;
    }

    .ingrediente-chip {
        width: 100%;
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 0;
        padding: 7px 12px;
        border-radius: 18px;
        background: #e8f4fd;
        color: #1a3a6e;
        cursor: pointer;
        line-height: 1.35;
        overflow-wrap: anywhere;
        transition: background 0.2s ease, transform 0.15s ease;
    }

        .ingrediente-chip:hover {
            background: #d7ecfa;
            transform: translateY(-1px);
        }

        .ingrediente-chip input {
            flex-shrink: 0;
            margin-top: 0.18rem;
        }

    /* ═══════════════════════════════════════
           IMAGEN ACTUAL
           ═══════════════════════════════════════ */

    .imagen-actual-wrapper {
        margin-bottom: 0.8rem;
    }

    .imagen-actual-label {
        margin-bottom: 0.45rem;
        color: #4fa8e8;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .img-preview-actual {
        display: block;
        width: 100%;
        max-width: 220px;
        max-height: 180px;
        object-fit: cover;
        border: 1.5px solid #d0e8f8;
        border-radius: 10px;
        box-shadow: 0 2px 10px rgba(26, 58, 110, 0.08);
    }

    /* ═══════════════════════════════════════
           ACCIONES
           ═══════════════════════════════════════ */

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .btn-guardar,
    .btn-cancelar {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 28px;
        border-radius: 8px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
        text-align: center;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

    .btn-guardar {
        border: none;
        background: #1a3a6e;
        color: #ffffff;
    }

        .btn-guardar:hover {
            background: #c0392b;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .btn-cancelar {
        border: 1.5px solid #1a3a6e;
        background: #ffffff;
        color: #1a3a6e;
    }

        .btn-cancelar:hover {
            background: #1a3a6e;
            color: #ffffff;
            transform: translateY(-1px);
        }

    /* ═══════════════════════════════════════
           TABLET
           ═══════════════════════════════════════ */

    @@media (max-width: 768px) {

        .producto-form-page {
            padding: 0.75rem 0 1.5rem;
        }

        .form-header {
            margin-bottom: 1.5rem;
        }

        .form-card {
            padding: 1.5rem;
        }

        .ingredientes-grid {
            grid-template-columns: repeat( auto-fit, minmax(170px, 1fr) );
        }
    }

    /* ═══════════════════════════════════════
           MÓVIL
           ═══════════════════════════════════════ */

    @@media (max-width: 576px) {

        .producto-form-page {
            padding-top: 0.5rem;
        }

        .form-header {
            margin-bottom: 1.25rem;
            padding-bottom: 0.8rem;
        }

        .form-title {
            font-size: 1.6rem;
        }

        .form-card {
            padding: 1.2rem;
            border-radius: 12px;
        }

        .form-control,
        .form-select {
            font-size: 0.95rem;
        }

        .ingredientes-grid {
            grid-template-columns: 1fr;
            max-height: 300px;
            padding: 0.75rem;
        }

        .ingrediente-chip {
            padding: 0.65rem 0.75rem;
        }

        .img-preview-actual {
            max-width: 100%;
            max-height: 220px;
        }

        .form-actions {
            width: 100%;
            flex-direction: column;
        }

        .btn-guardar,
        .btn-cancelar {
            width: 100%;
            min-height: 46px;
        }
    }

    /* ═══════════════════════════════════════
           TELÉFONO PEQUEÑO
           ═══════════════════════════════════════ */

    @@media (max-width: 390px) {

        .form-card {
            padding: 1rem 0.9rem;
        }

        .form-title {
            font-size: 1.5rem;
        }

        .ingredientes-grid {
            padding: 0.65rem;
        }

        .ingrediente-chip {
            font-size: 0.9rem;
        }

        .img-preview-actual {
            max-height: 190px;
        }
    }

    /* ═══════════════════════════════════════
           MOVIMIENTO REDUCIDO
           ═══════════════════════════════════════ */

    @@media (prefers-reduced-motion: reduce) {

        .ingrediente-chip,
        .btn-guardar,
        .btn-cancelar {
            transition: none;
        }
    }
</style>

<div class="producto-form-page">

    <!-- HEADER -->

    <div class="form-header">

        <h1 class="form-title">
            Editar Producto
        </h1>

    </div>

    <!-- FORMULARIO -->

    <div class="form-card">

        <form asp-action="Editar"
              asp-route-id="@Model.IdProducto"
              enctype="multipart/form-data"
              method="post">

            <input type="hidden"
                   asp-for="IdProducto" />

            <input type="hidden"
                   asp-for="ImagenActualUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <!-- NOMBRE -->

            <div class="mb-3">

                <label asp-for="Nombre"
                       class="form-label">
                </label>

                <input asp-for="Nombre"
                       class="form-control" />

                <span asp-validation-for="Nombre"
                      class="text-danger">
                </span>

            </div>

            <!-- DESCRIPCIÓN -->

            <div class="mb-3">

                <label asp-for="Descripcion"
                       class="form-label">
                </label>

                <textarea asp-for="Descripcion"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Descripcion"
                      class="text-danger">
                </span>

            </div>

            <!-- PRECIO / CATEGORÍA -->

            <div class="row g-3">

                <div class="col-12 col-md-6">

                    <label asp-for="Precio"
                           class="form-label">

                        Precio (₡)

                    </label>

                    <input asp-for="Precio"
                           type="number"
                           step="0.01"
                           inputmode="decimal"
                           class="form-control" />

                    <span asp-validation-for="Precio"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12 col-md-6">

                    <label asp-for="IdCategoria"
                           class="form-label">

                        Categoría

                    </label>

                    <select asp-for="IdCategoria"
                            class="form-select">

                        <option value="">
                            -- Seleccione una categoría --
                        </option>

                        @foreach (
                                                var cat in Model.CategoriasDisponibles
                                                )
                        {
                            <option value="@cat.IdCategoria">
                                @cat.Nombre
                            </option>
                        }

                    </select>

                    <span asp-validation-for="IdCategoria"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- INGREDIENTES -->

            <div class="mt-3 mb-3">

                <label class="form-label">
                    Ingredientes
                </label>

                <div class="ingredientes-grid">

                    @foreach (
                                        var ing in Model.IngredientesDisponibles
                                        )
                    {
                        var marcado =
                        Model.IngredientesSeleccionados
                        .Contains(
                        ing.IdIngrediente
                        );

                        <label class="ingrediente-chip">

                            <input type="checkbox"
                                   name="IngredientesSeleccionados"
                                   value="@ing.IdIngrediente"
                                   checked="@(marcado ? "checked" : null)" />

                            <span>
                                @ing.Nombre
                            </span>

                        </label>
                    }

                </div>

                <span asp-validation-for="IngredientesSeleccionados"
                      class="text-danger">
                </span>

            </div>

            <!-- IMAGEN -->

            <div class="mb-4">

                @if (
                                !string.IsNullOrEmpty(
                                Model.ImagenActualUrl
                                )
                                )
                {
                    <div class="imagen-actual-wrapper">

                        <div class="imagen-actual-label">
                            Imagen actual
                        </div>

                        <img src="@Model.ImagenActualUrl"
                             class="img-preview-actual"
                             alt="Imagen actual de @Model.Nombre" />

                    </div>
                }

                <label asp-for="Imagen"
                       class="form-label">

                    Cambiar imagen (opcional)

                </label>

                <input asp-for="Imagen"
                       type="file"
                       accept="image/*"
                       class="form-control" />

                <span asp-validation-for="Imagen"
                      class="text-danger">
                </span>

            </div>

            <!-- ACCIONES -->

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-guardar">

                    Guardar cambios

                </button>

                <a asp-action="Detalle"
                   asp-route-id="@Model.IdProducto"
                   class="btn-cancelar">

                    Cancelar

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}