@model TempestSushi.Application.DTOs.UsuarioEditarDTO

@{
    ViewData["Title"] = "Editar usuario";
}

<style>
    .usuario-form-page {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        padding: 1rem 0 2rem;
    }

    .usuario-form-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
    }

    .usuario-form-title {
        margin: 0;
        font-family: 'Rajdhani', sans-serif;
        font-size: clamp(1.7rem, 4vw, 2rem);
        font-weight: 700;
        color: #1a3a6e;
        letter-spacing: 1px;
        line-height: 1.2;
    }

    .usuario-form-subtitle {
        margin-top: 0.25rem;
        margin-bottom: 0;
        color: #7895ad;
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .usuario-form-card {
        width: 100%;
        padding: 2rem;
        background: #ffffff;
        border: 1px solid #dceaf5;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(26, 58, 110, 0.08);
    }

    .usuario-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 1.25rem;
    }

    .usuario-form-group {
        min-width: 0;
        margin-bottom: 1.35rem;
    }

    .usuario-form-full {
        grid-column: 1 / -1;
    }

    .usuario-label {
        display: block;
        margin-bottom: 0.45rem;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        color: #1a3a6e;
    }

    .usuario-input,
    .usuario-select {
        width: 100%;
        min-width: 0;
        padding: 0.7rem 0.85rem;
        border: 1px solid #cfe0ed;
        border-radius: 9px;
        background: #ffffff;
        color: #294869;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .usuario-input:focus,
        .usuario-select:focus {
            border-color: #4fa8e8;
            box-shadow: 0 0 0 3px rgba(79, 168, 232, 0.12);
        }

    .usuario-validation {
        display: block;
        margin-top: 0.35rem;
        color: #c0392b;
        font-size: 0.78rem;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .usuario-summary {
        margin-bottom: 1.25rem;
        padding: 0.8rem 1rem;
        border: 1px solid rgba(192, 57, 43, 0.20);
        border-radius: 9px;
        background: rgba(192, 57, 43, 0.08);
        color: #a93226;
        font-size: 0.85rem;
        line-height: 1.45;
    }

        .usuario-summary:empty {
            display: none;
        }

    .usuario-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 0.75rem;
    }

    .usuario-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.4rem;
        border: none;
        border-radius: 999px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .usuario-btn-volver {
        border: 1px solid #d0e8f8;
        background: #eef5fa;
        color: #1a3a6e;
    }

        .usuario-btn-volver:hover {
            background: #e0edf6;
            color: #1a3a6e;
            transform: translateY(-1px);
        }

    .usuario-btn-guardar {
        background: #1a3a6e;
        color: #ffffff;
    }

        .usuario-btn-guardar:hover {
            background: #244d91;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(26, 58, 110, 0.22);
        }

    @@media (max-width: 700px) {

        .usuario-form-grid {
            grid-template-columns: 1fr;
        }

        .usuario-form-full {
            grid-column: auto;
        }

        .usuario-form-card {
            padding: 1.4rem;
        }

        .usuario-actions {
            flex-direction: column-reverse;
        }

        .usuario-btn {
            width: 100%;
        }
    }

    @@media (max-width: 576px) {

        .usuario-form-page {
            padding-top: 0.5rem;
        }

        .usuario-form-header {
            margin-bottom: 1.25rem;
            padding-bottom: 0.8rem;
        }

        .usuario-form-title {
            font-size: 1.6rem;
        }

        .usuario-form-subtitle {
            font-size: 0.84rem;
        }

        .usuario-form-card {
            padding: 1.2rem;
            border-radius: 12px;
        }

        .usuario-input,
        .usuario-select {
            font-size: 0.95rem;
        }

        .usuario-btn {
            min-height: 46px;
        }
    }

    @@media (max-width: 390px) {

        .usuario-form-card {
            padding: 1rem 0.9rem;
        }

        .usuario-form-title {
            font-size: 1.5rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .usuario-btn {
            transition: none;
        }
    }
</style>

<div class="usuario-form-page">

    <div class="usuario-form-header">

        <h1 class="usuario-form-title">
            Editar usuario
        </h1>

        <p class="usuario-form-subtitle">
            Modifique los datos generales, rol y estado de la cuenta.
        </p>

    </div>

    <div class="usuario-form-card">

        <form asp-controller="Usuario"
              asp-action="Edit"
              method="post">

            <input asp-for="IdUsuario"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="usuario-summary">
            </div>

            <div class="usuario-form-grid">

                <div class="usuario-form-group">

                    <label asp-for="Nombre"
                           class="usuario-label">
                    </label>

                    <input asp-for="Nombre"
                           class="usuario-input" />

                    <span asp-validation-for="Nombre"
                          class="usuario-validation">
                    </span>

                </div>

                <div class="usuario-form-group">

                    <label asp-for="Apellidos"
                           class="usuario-label">
                    </label>

                    <input asp-for="Apellidos"
                           class="usuario-input" />

                    <span asp-validation-for="Apellidos"
                          class="usuario-validation">
                    </span>

                </div>

                <div class="usuario-form-group usuario-form-full">

                    <label asp-for="Correo"
                           class="usuario-label">
                    </label>

                    <input asp-for="Correo"
                           class="usuario-input" />

                    <span asp-validation-for="Correo"
                          class="usuario-validation">
                    </span>

                </div>

                <div class="usuario-form-group">

                    <label asp-for="Telefono"
                           class="usuario-label">
                    </label>

                    <input asp-for="Telefono"
                           class="usuario-input"
                           inputmode="tel" />

                    <span asp-validation-for="Telefono"
                          class="usuario-validation">
                    </span>

                </div>

                <div class="usuario-form-group">

                    <label asp-for="IdRolUsuario"
                           class="usuario-label">
                    </label>

                    <select asp-for="IdRolUsuario"
                            asp-items="ViewBag.Roles"
                            class="usuario-select">

                        <option value="">
                            Seleccione un rol...
                        </option>

                    </select>

                    <span asp-validation-for="IdRolUsuario"
                          class="usuario-validation">
                    </span>

                </div>

            </div>

            <div class="usuario-actions">

                <a asp-controller="Usuario"
                   asp-action="Index"
                   class="usuario-btn usuario-btn-volver">

                    Volver

                </a>

                <button type="submit"
                        class="usuario-btn usuario-btn-guardar">

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        if (
            typeof anime !== 'undefined' &&
            !window.matchMedia(
                '(prefers-reduced-motion: reduce)'
            ).matches
        )
        {
            anime({
                targets: '.usuario-form-header',
                opacity: [0, 1],
                translateY: [-12, 0],
                duration: 550,
                easing: 'easeOutQuad'
            });

            anime({
                targets: '.usuario-form-card',
                opacity: [0, 1],
                translateY: [18, 0],
                delay: 120,
                duration: 650,
                easing: 'easeOutExpo'
            });
        }

    </script>

}