@model TempestSushi.Application.DTOs.MenuDisponibleDto

@{
    ViewData["Title"] = "Menú Disponible";
}

<div class="container">
    @if (Model == null)
    {
        <div class="alert alert-warning text-center mt-4">
            @ViewBag.Mensaje
        </div>
        <div class="text-center">
            <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-light">⬅ Volver al listado</a>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <h1 class="text-success">@Model.Nombre</h1>
            <p class="text-light">
                <strong>Días:</strong> @Model.Dias &nbsp;|&nbsp;
                <strong>Horario:</strong> @Model.Horario &nbsp;|&nbsp;
                <strong>Vigencia:</strong> @Model.Vigencia
            </p>
        </div>

        @foreach (var categoria in Model.Categorias)
        {
            <div class="mb-5">
                <h3 class="text-success border-bottom border-success pb-2 mb-3">@categoria.NombreCategoria</h3>
                <div class="row g-3">
                    @foreach (var item in categoria.Items)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card bg-dark text-light border-secondary h-100">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@item.Nombre</h6>
                                        <small class="text-muted">@item.Tipo</small>
                                    </div>
                                    <span class="badge bg-success">₡@item.Precio.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-light">⬅ Volver al listado</a>
        </div>
    }
</div>