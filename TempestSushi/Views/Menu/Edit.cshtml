@model TempestSushi.Application.DTOs.MenuFormDto

@{
    ViewData["Title"] = "Editar Menú";
}

<style>
    .menu-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
        opacity: 0;
    }

    .menu-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: #1a3a6e;
        letter-spacing: 1px;
        margin: 0;
    }

    .menu-badge {
        background: #1a3a6e;
        color: #4fa8e8;
        font-size: .7rem;
        letter-spacing: 2px;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .menu-form-card {
        background: #fff;
        border: 1.5px solid #d0e8f8;
        border-radius: 14px;
        padding: 2rem;
        box-shadow: 0 4px 18px rgba(26, 58, 110, 0.09);
        opacity: 0;
    }

    .form-section-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a3a6e;
        margin-bottom: 1rem;
        padding-bottom: .5rem;
        border-bottom: 1px solid #d0e8f8;
    }

    .form-label {
        color: #1a3a6e;
        font-weight: 600;
        font-size: .9rem;
    }

    .form-control,
    .form-select {
        border: 1.5px solid #d0e8f8;
        border-radius: 8px;
        color: #1a3a6e;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #4fa8e8;
            box-shadow: 0 0 0 .2rem rgba(79, 168, 232, .18);
        }

    .selection-box {
        border: 1.5px solid #d0e8f8;
        border-radius: 10px;
        padding: 1rem;
        max-height: 260px;
        overflow-y: auto;
        background: #f8fcff;
    }

    .selection-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 4px;
        color: #1a3a6e;
    }

        .selection-item:not(:last-child) {
            border-bottom: 1px solid #e8f4fd;
        }

    .form-check-input:checked {
        background-color: #1a3a6e;
        border-color: #1a3a6e;
    }

    .btn-guardar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1a3a6e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 1px;
        transition: background .2s, transform .2s;
    }

        .btn-guardar:hover {
            background: #244f91;
            transform: translateY(-2px);
        }

    .btn-cancelar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: #1a3a6e;
        border: 1.5px solid #1a3a6e;
        border-radius: 8px;
        padding: 9px 24px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-decoration: none;
        transition: background .2s, color .2s;
    }

        .btn-cancelar:hover {
            background: #1a3a6e;
            color: #fff;
        }

    .text-danger {
        font-size: .82rem;
    }
</style>

<h1 class="menu-title">Editar Menú</h1>
<span class="menu-badge">EDICIÓN</span>

<div class="menu-form-card" id="menuFormCard">
    <form asp-controller="Menu" asp-action="Edit" method="post">
        <input asp-for="IdMenu" type="hidden" />
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="form-section-title">Información general</div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Ejemplo: Menú de temporada" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FechaFin" class="form-label"></label>
                <input asp-for="FechaFin"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="HoraInicio" class="form-label"></label>
                <input asp-for="HoraInicio"
                       type="time"
                       class="form-control" />
                <span asp-validation-for="HoraInicio" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="HoraFin" class="form-label"></label>
                <input asp-for="HoraFin"
                       type="time"
                       class="form-control" />
                <span asp-validation-for="HoraFin" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="DiasDisponibles" class="form-label"></label>

                <select asp-for="DiasDisponibles" class="form-select">

                    @foreach (var opcion in Model.OpcionesDiasDisponibles)
                    {
                        <option value="@opcion">@opcion</option>
                    }
                </select>

                <span asp-validation-for="DiasDisponibles"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Activo"
                           class="form-check-input" />
                    <label asp-for="Activo"
                           class="form-check-label form-label">
                    </label>
                </div>
            </div>
        </div>

        <div class="form-section-title mt-4">Elementos del menú</div>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Productos</label>

                <div class="selection-box">
                    @if (Model.ProductosDisponibles.Any())
                    {
                        @foreach (var producto in Model.ProductosDisponibles)
                        {
                            <label class="selection-item">
                                <input type="checkbox"
                                       name="ProductosSeleccionados"
                                       value="@producto.Id"
                                       class="form-check-input"
                                       checked="@Model.ProductosSeleccionados.Contains(producto.Id)" />

                                <span>@producto.Nombre</span>
                            </label>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No hay productos disponibles.
                        </span>
                    }
                </div>

                <span asp-validation-for="ProductosSeleccionados"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Combos</label>

                <div class="selection-box">
                    @if (Model.CombosDisponibles.Any())
                    {
                        @foreach (var combo in Model.CombosDisponibles)
                        {
                            <label class="selection-item">
                                <input type="checkbox"
                                       name="CombosSeleccionados"
                                       value="@combo.Id"
                                       class="form-check-input"
                                       checked="@Model.CombosSeleccionados.Contains(combo.Id)" />

                                <span>@combo.Nombre</span>
                            </label>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No hay combos disponibles.
                        </span>
                    }
                </div>

                <span asp-validation-for="CombosSeleccionados"
                      class="text-danger"></span>
            </div>
        </div>



        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn-guardar">
                💾 Guardar cambios
            </button>

            <a asp-controller="Menu"
               asp-action="Index"
               class="btn-cancelar">
                ↩ Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <script>
        anime({
            targets: '#menuHeader',
            translateY: [-20, 0],
            opacity: [0, 1],
            duration: 600,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '#menuFormCard',
            translateY: [30, 0],
            opacity: [0, 1],
            duration: 600,
            delay: 150,
            easing: 'easeOutExpo'
        });
    </script>
}