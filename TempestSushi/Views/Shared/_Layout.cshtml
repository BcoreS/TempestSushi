@using System.Security.Claims

@{
    var rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value;

    var esPaginaLogin =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Account"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Login";

    var claseRol = rolUsuario switch
    {
        "Administrador" => "ts-role-admin",
        "Encargado" => "ts-role-encargado",
        "Cocina" => "ts-role-cocina",
        "Cliente" => "ts-role-cliente",
        _ => "ts-role-default"
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TempestSushi</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+JP:wght@400;500&display=swap"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <style>
        :root {
            --ts-navy: #1a3a6e;
            --ts-blue: #4fa8e8;
            --ts-red: #c0392b;
            --ts-orange: #d68910;
            --ts-bg: #f0f6fc;
            --ts-border: #d0e8f8;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            font-family: 'Noto Sans JP', sans-serif;
            background: var(--ts-bg);
        }

        /* ═══════════════════════════════════════
                   NAVBAR
                   ═══════════════════════════════════════ */

        .ts-navbar {
            min-height: 72px;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(26, 58, 110, 0.12);
            box-shadow: 0 3px 18px rgba(26, 58, 110, 0.09);
            opacity: 0;
        }

        .ts-gradient-bar {
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient( 90deg, var(--ts-navy), var(--ts-blue), var(--ts-red) );
            border-radius: 2px;
        }

        /* ═══════════════════════════════════════
                   BRAND
                   ═══════════════════════════════════════ */

        .ts-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            flex-shrink: 0;
        }

            .ts-brand img {
                height: 50px;
                width: auto;
                filter: drop-shadow( 0 2px 6px rgba(26, 58, 110, 0.18) );
            }

        .ts-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .ts-brand-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--ts-navy);
            letter-spacing: 1.8px;
        }

        .ts-brand-sub {
            margin-top: 3px;
            font-size: 0.58rem;
            font-weight: 500;
            color: var(--ts-blue);
            letter-spacing: 2.4px;
        }

        /* ═══════════════════════════════════════
                   PARTE DERECHA
                   ═══════════════════════════════════════ */

        .ts-navbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 0;
        }

        /* ═══════════════════════════════════════
                   NAVEGACIÓN
                   ═══════════════════════════════════════ */

        .ts-nav {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .ts-nav > li > .nav-link {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                padding: 0.48rem 0.85rem;
                border-radius: 999px;
                font-family: 'Rajdhani', sans-serif;
                font-size: 0.94rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                color: var(--ts-navy);
                text-decoration: none;
                transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
            }

                .ts-nav > li > .nav-link:hover,
                .ts-nav > li > .nav-link.active {
                    color: var(--ts-red);
                    background: rgba(192, 57, 43, 0.07);
                    transform: translateY(-1px);
                }

            /* ═══════════════════════════════════════
                   DROPDOWNS
                   ═══════════════════════════════════════ */

            .ts-nav .dropdown-menu {
                min-width: 215px;
                margin-top: 0.65rem;
                padding: 0.5rem;
                border: 1px solid rgba(26, 58, 110, 0.12);
                border-radius: 13px;
                background: rgba(255, 255, 255, 0.98);
                box-shadow: 0 14px 38px rgba(26, 58, 110, 0.16);
            }

            .ts-nav .dropdown-item {
                display: flex;
                align-items: center;
                padding: 0.58rem 0.75rem;
                border-radius: 8px;
                font-family: 'Rajdhani', sans-serif;
                font-weight: 700;
                font-size: 0.9rem;
                color: var(--ts-navy);
                transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
            }

                .ts-nav .dropdown-item:hover {
                    background: rgba(79, 168, 232, 0.10);
                    color: var(--ts-red);
                    transform: translateX(2px);
                }

        .ts-dropdown-label {
            padding: 0.35rem 0.75rem 0.25rem;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.10em;
            color: #91a8bb;
            text-transform: uppercase;
        }

        .ts-dropdown-divider {
            height: 1px;
            margin: 0.35rem 0;
            background: #e5eef5;
        }

        /* ═══════════════════════════════════════
                   BADGE PEDIDOS
                   ═══════════════════════════════════════ */

        .ts-cart-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            margin-left: 4px;
            border-radius: 999px;
            background: var(--ts-red);
            color: #ffffff;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
        }

        /* ═══════════════════════════════════════
                   USUARIO
                   ═══════════════════════════════════════ */

        .ts-user-area {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding-left: 1rem;
            border-left: 1px solid var(--ts-border);
            flex-shrink: 0;
        }

        .ts-user-info {
            display: flex;
            flex-direction: column;
            text-align: right;
            line-height: 1.1;
        }

        .ts-user-greeting {
            align-self: flex-end;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 3px;
            padding: 3px 9px;
            border-radius: 999px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: #ffffff;
            text-transform: uppercase;
            white-space: nowrap;
            box-shadow: 0 2px 7px rgba(0, 0, 0, 0.13);
        }

        .ts-role-admin {
            background: var(--ts-red);
        }

        .ts-role-encargado {
            background: var(--ts-navy);
        }

        .ts-role-cocina {
            background: var(--ts-orange);
        }

        .ts-role-cliente {
            background: #3498db;
        }

        .ts-role-default {
            background: #6c757d;
        }

        .ts-user-name {
            max-width: 165px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--ts-navy);
        }

        /* ═══════════════════════════════════════
                   LOGOUT / LOGIN
                   ═══════════════════════════════════════ */

        .ts-logout-form {
            margin: 0;
        }

        .ts-logout-button,
        .ts-login-link {
            padding: 0.42rem 0.9rem;
            border-radius: 999px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }

        .ts-logout-button {
            border: 1px solid rgba(192, 57, 43, 0.28);
            background: rgba(192, 57, 43, 0.05);
            color: var(--ts-red);
            cursor: pointer;
        }

            .ts-logout-button:hover {
                background: var(--ts-red);
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 5px 14px rgba(192, 57, 43, 0.2);
            }

        .ts-login-link {
            border: 1px solid rgba(26, 58, 110, 0.25);
            color: var(--ts-navy);
            text-decoration: none;
        }

            .ts-login-link:hover {
                background: var(--ts-navy);
                color: #ffffff;
                transform: translateY(-1px);
            }

        /* ═══════════════════════════════════════
                   CONTENIDO
                   ═══════════════════════════════════════ */

        .ts-main {
            width: 100%;
            flex: 1 0 auto;
            opacity: 0;
        }

        /* ═══════════════════════════════════════
                   FOOTER
                   ═══════════════════════════════════════ */

        footer.ts-footer {
            flex-shrink: 0;
            margin-top: auto;
            padding: 1.25rem 2rem;
            border-top: 1px solid var(--ts-border);
            background: #ffffff;
            text-align: center;
            color: #8ab2cc;
            font-size: 0.82rem;
            letter-spacing: 1px;
            opacity: 0;
        }

            footer.ts-footer a {
                color: var(--ts-navy);
                text-decoration: none;
                font-weight: 600;
            }

        /* ═══════════════════════════════════════
                   RESPONSIVE
                   ═══════════════════════════════════════ */

        @@media (max-width: 1050px) {

            .ts-brand-sub {
                display: none;
            }

            .ts-brand-title {
                font-size: 1.15rem;
            }

            .ts-brand img {
                height: 44px;
            }

            .ts-navbar {
                padding: 0 1rem;
            }

            .ts-nav > li > .nav-link {
                padding: 0.42rem 0.65rem;
                font-size: 0.88rem;
            }
        }

        @@media (max-width: 768px) {

            .ts-navbar {
                min-height: 68px;
                flex-wrap: wrap;
                padding: 0.5rem 1rem;
            }

            .ts-navbar-right {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 0.7rem;
            }

            .ts-nav {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                padding: 0.75rem 0;
            }

                .ts-nav > li {
                    width: 100%;
                }

                    .ts-nav > li > .nav-link {
                        width: 100%;
                        justify-content: space-between;
                        border-radius: 8px;
                    }

            .ts-user-area {
                width: 100%;
                justify-content: space-between;
                padding: 0.8rem 0;
                border-left: none;
                border-top: 1px solid var(--ts-border);
            }

            .ts-user-info {
                text-align: left;
            }

            .ts-user-greeting {
                align-self: flex-start;
            }
        }
    </style>
</head>

<body>

    <header>

        <nav class="ts-navbar"
             id="tsNavbar">

            <div class="ts-gradient-bar"
                 id="tsGradientBar">
            </div>

            <a class="ts-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.png"
                     alt="Tempest Sushi Logo" />

                <div class="ts-brand-text">

                    <span class="ts-brand-title">
                        TEMPEST SUSHI
                    </span>

                    <span class="ts-brand-sub">
                        テンペスト 寿司 · REINO DE TEMPEST
                    </span>

                </div>

            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler d-md-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tsNavCollapse"
                        aria-controls="tsNavCollapse"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>
            }

            <div class="ts-navbar-right">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="ts-nav collapse d-md-flex"
                        id="tsNavCollapse">

                        <!-- HOME -->
                        <li>

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>

                        <!-- OPERACIÓN -->
                        @if (User.IsInRole("Cliente")
                                            || User.IsInRole("Encargado")
                                            || User.IsInRole("Administrador")
                                            || User.IsInRole("Cocina"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    Operación

                                </a>

                                <ul class="dropdown-menu">

                                    @if (User.IsInRole("Cliente")
                                                                || User.IsInRole("Encargado")
                                                                || User.IsInRole("Administrador"))
                                    {
                                        <li class="ts-dropdown-label">
                                            Catálogo
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Producto"
                                               asp-action="Index">
                                                Productos
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Combo"
                                               asp-action="Index">
                                                Combos
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Menu"
                                               asp-action="Index">
                                                Menús
                                            </a>
                                        </li>

                                        <li>
                                            <div class="ts-dropdown-divider">
                                            </div>
                                        </li>

                                        <li class="ts-dropdown-label">
                                            Pedidos
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Pedido"
                                               asp-action="Index">

                                                Pedidos

                                                <span id="ts-cart-badge"
                                                      class="ts-cart-badge"
                                                      style="display:none;">
                                                    0
                                                </span>

                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Cocina")
                                                                || User.IsInRole("Administrador"))
                                    {
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <li>
                                                <div class="ts-dropdown-divider">
                                                </div>
                                            </li>
                                        }

                                        <li class="ts-dropdown-label">
                                            Cocina
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="ProcesoPreparacion"
                                               asp-action="Index">
                                                Preparación
                                            </a>
                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                        <!-- ADMINISTRACIÓN -->
                        @if (User.IsInRole("Administrador")
                                            || User.IsInRole("Encargado"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    Administración

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    @if (User.IsInRole("Encargado")
                                                                || User.IsInRole("Administrador"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Reporte"
                                               asp-action="Index">
                                                Reportes
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Usuario"
                                               asp-action="Index">
                                                Usuarios
                                            </a>
                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                    </ul>

                    <div class="ts-user-area">

                        <div class="ts-user-info">

                            <span class="ts-user-greeting @claseRol">
                                @rolUsuario
                            </span>

                            <span class="ts-user-name"
                                  title="@User.Identity.Name">
                                @User.Identity.Name
                            </span>

                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="ts-logout-form">

                            <button type="submit"
                                    class="ts-logout-button">
                                Cerrar sesión
                            </button>

                        </form>

                    </div>
                }
                else if (!esPaginaLogin)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="ts-login-link">
                        Iniciar sesión
                    </a>
                }

            </div>

        </nav>

    </header>

    <div class="container ts-main"
         id="tsMain">

        <main role="main"
              class="pb-4 pt-3">

            @RenderBody()

        </main>

    </div>

    @await RenderSectionAsync(
    "Modals",
        required: false)

    <footer class="ts-footer"
            id="tsFooter">

        &copy; 2026 —
        <strong>TempestSushi</strong>

        &nbsp;·&nbsp;

        <a asp-controller="Home"
           asp-action="Privacy">
            Privacy
        </a>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <script>

        anime({
            targets: '#tsNavbar',
            translateY: [-64, 0],
            opacity: [0, 1],
            duration: 700,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '#tsMain',
            translateY: [24, 0],
            opacity: [0, 1],
            duration: 700,
            delay: 250,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '#tsFooter',
            opacity: [0, 1],
            duration: 600,
            delay: 450,
            easing: 'easeOutSine'
        });

        anime({
            targets: '#tsGradientBar',
            width: ['60px', '100%'],
            duration: 900,
            delay: 200,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '.ts-brand img',
            translateY: [
                {
                    value: -5,
                    duration: 1200
                },
                {
                    value: 0,
                    duration: 1200
                }
            ],
            loop: true,
            easing: 'easeInOutSine'
        });

        anime({
            targets: '.ts-user-greeting',
            opacity: [0, 1],
            scale: [0.85, 1],
            delay: 500,
            duration: 500,
            easing: 'easeOutBack'
        });

        (function markActiveNav() {

            const path =
                window.location.pathname
                    .toLowerCase();

            document
                .querySelectorAll(
                    '.ts-nav a[href]'
                )
                .forEach(function (a) {

                    const href =
                        a.getAttribute('href') || '';

                    if (!href ||
                        href === '#') {
                        return;
                    }

                    if (
                        href === '/'
                            ? path === '/'
                            : path.startsWith(
                                href.toLowerCase()
                            )
                    ) {
                        a.classList.add(
                            'active'
                        );

                        const dropdown =
                            a.closest(
                                '.dropdown'
                            );

                        if (dropdown) {

                            const toggle =
                                dropdown.querySelector(
                                    '.dropdown-toggle'
                                );

                            if (toggle) {
                                toggle.classList.add(
                                    'active'
                                );
                            }
                        }
                    }
                });

        })();

        document
            .querySelectorAll(
                '.ts-nav .nav-link'
            )
            .forEach(function (a) {

                a.addEventListener(
                    'click',
                    function () {

                        anime({
                            targets: a,
                            scale: [
                                1,
                                1.05,
                                1
                            ],
                            duration: 260,
                            easing: 'easeOutQuad'
                        });

                    });
            });

    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>