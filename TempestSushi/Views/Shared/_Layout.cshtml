@using System.Security.Claims

@{
    var rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value;

    var esPaginaLogin =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Account"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Login";

    var claseRol = rolUsuario switch
    {
        "Administrador" => "ts-role-admin",
        "Encargado" => "ts-role-encargado",
        "Cocina" => "ts-role-cocina",
        "Cliente" => "ts-role-cliente",
        _ => "ts-role-default"
    };
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - TempestSushi
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+JP:wght@400;500&display=swap"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <style>

        :root {
            --ts-navy: #1a3a6e;
            --ts-blue: #4fa8e8;
            --ts-red: #c0392b;
            --ts-orange: #d68910;
            --ts-bg: #f0f6fc;
            --ts-border: #d0e8f8;
            --ts-muted: #7895ad;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            font-family: 'Noto Sans JP', sans-serif;
            background: var(--ts-bg);
            overflow-x: hidden;
        }

        /* ═══════════════════════════════════════
                                   NAVBAR
                                   ═══════════════════════════════════════ */

        .ts-navbar {
            width: 100%;
            min-height: 72px;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(26, 58, 110, 0.12);
            box-shadow: 0 3px 18px rgba(26, 58, 110, 0.09);
            opacity: 1;
        }

        .ts-gradient-bar {
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient( 90deg, var(--ts-navy), var(--ts-blue), var(--ts-red) );
            border-radius: 2px;
        }

        /* ═══════════════════════════════════════
                                   BRAND
                                   ═══════════════════════════════════════ */

        .ts-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
            flex-shrink: 0;
            text-decoration: none;
        }

            .ts-brand img {
                height: 50px;
                width: auto;
                flex-shrink: 0;
                filter: drop-shadow( 0 2px 6px rgba(26, 58, 110, 0.18) );
            }

        .ts-brand-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .ts-brand-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--ts-navy);
            letter-spacing: 1.8px;
            white-space: nowrap;
        }

        .ts-brand-sub {
            margin-top: 3px;
            font-size: 0.58rem;
            font-weight: 500;
            color: var(--ts-blue);
            letter-spacing: 2.4px;
            white-space: nowrap;
        }

        .ts-nav-icon {
            flex-shrink: 0;
            opacity: 0.85;
        }

        .ts-navbar-toggler.ts-toggler-open .ts-toggler-icon span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .ts-navbar-toggler.ts-toggler-open .ts-toggler-icon span:nth-child(2) {
            opacity: 0;
        }

        .ts-navbar-toggler.ts-toggler-open .ts-toggler-icon span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* ═══════════════════════════════════════
                                   BOTÓN HAMBURGUESA
                                   ═══════════════════════════════════════ */

        .ts-navbar-toggler {
            display: none;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 40px;
            padding: 0;
            border: 1px solid rgba(26, 58, 110, 0.18);
            border-radius: 10px;
            background: #ffffff;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .ts-navbar-toggler:hover {
                background: rgba(79, 168, 232, 0.07);
                border-color: rgba(26, 58, 110, 0.28);
            }

            .ts-navbar-toggler:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(79, 168, 232, 0.14);
            }

        .ts-toggler-icon {
            width: 21px;
            height: 16px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .ts-toggler-icon span {
                display: block;
                width: 100%;
                height: 2px;
                border-radius: 999px;
                background: var(--ts-navy);
                transition: transform 0.2s ease, opacity 0.2s ease;
            }

        /* ═══════════════════════════════════════
                                   CONTENEDOR DERECHO
                                   ═══════════════════════════════════════ */

        .ts-navbar-right {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .ts-nav-collapse {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        /* ═══════════════════════════════════════
                                   NAVEGACIÓN
                                   ═══════════════════════════════════════ */

        .ts-nav {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .ts-nav > li > .nav-link {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                padding: 0.48rem 0.85rem;
                border-radius: 999px;
                font-family: 'Rajdhani', sans-serif;
                font-size: 0.94rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                color: var(--ts-navy);
                text-decoration: none;
                white-space: nowrap;
                transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
            }

                .ts-nav > li > .nav-link:hover,
                .ts-nav > li > .nav-link.active {
                    color: var(--ts-red);
                    background: rgba(192, 57, 43, 0.07);
                    transform: translateY(-1px);
                }

            /* ═══════════════════════════════════════
                                   DROPDOWNS
                                   ═══════════════════════════════════════ */

            .ts-nav .dropdown-menu {
                min-width: 215px;
                margin-top: 0.65rem;
                padding: 0.5rem;
                border: 1px solid rgba(26, 58, 110, 0.12);
                border-radius: 13px;
                background: rgba(255, 255, 255, 0.98);
                box-shadow: 0 14px 38px rgba(26, 58, 110, 0.16);
            }

            .ts-nav .dropdown-item {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.58rem 0.75rem;
                border-radius: 8px;
                font-family: 'Rajdhani', sans-serif;
                font-weight: 700;
                font-size: 0.9rem;
                color: var(--ts-navy);
                transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
            }

                .ts-nav .dropdown-item:hover,
                .ts-nav .dropdown-item.active {
                    background: rgba(79, 168, 232, 0.10);
                    color: var(--ts-red);
                    transform: translateX(2px);
                }

        .ts-dropdown-label {
            padding: 0.35rem 0.75rem 0.25rem;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.10em;
            color: #91a8bb;
            text-transform: uppercase;
        }

        .ts-dropdown-divider {
            height: 1px;
            margin: 0.35rem 0;
            background: #e5eef5;
        }

        /* ═══════════════════════════════════════
                                   BADGE DE PEDIDOS
                                   ═══════════════════════════════════════ */

        .ts-cart-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            margin-left: 4px;
            border-radius: 999px;
            background: var(--ts-red);
            color: #ffffff;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
        }

        /* ═══════════════════════════════════════
                                   USUARIO
                                   ═══════════════════════════════════════ */

        .ts-user-area {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding-left: 1rem;
            border-left: 1px solid var(--ts-border);
            flex-shrink: 0;
        }

        .ts-user-info {
            min-width: 0;
            display: flex;
            flex-direction: column;
            text-align: right;
            line-height: 1.1;
        }

        .ts-user-greeting {
            align-self: flex-end;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 3px;
            padding: 3px 9px;
            border-radius: 999px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: #ffffff;
            text-transform: uppercase;
            white-space: nowrap;
            box-shadow: 0 2px 7px rgba(0, 0, 0, 0.13);
        }

        .ts-role-admin {
            background: var(--ts-red);
        }

        .ts-role-encargado {
            background: var(--ts-navy);
        }

        .ts-role-cocina {
            background: var(--ts-orange);
        }

        .ts-role-cliente {
            background: #3498db;
        }

        .ts-role-default {
            background: #6c757d;
        }

        .ts-user-name {
            max-width: 165px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--ts-navy);
        }

        /* ═══════════════════════════════════════
                                   LOGIN / LOGOUT
                                   ═══════════════════════════════════════ */

        .ts-logout-form {
            margin: 0;
            flex-shrink: 0;
        }

        .ts-logout-button,
        .ts-login-link {
            padding: 0.42rem 0.9rem;
            border-radius: 999px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            white-space: nowrap;
            transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }

        .ts-logout-button {
            border: 1px solid rgba(192, 57, 43, 0.28);
            background: rgba(192, 57, 43, 0.05);
            color: var(--ts-red);
            cursor: pointer;
        }

            .ts-logout-button:hover {
                background: var(--ts-red);
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 5px 14px rgba(192, 57, 43, 0.2);
            }

        .ts-login-link {
            border: 1px solid rgba(26, 58, 110, 0.25);
            color: var(--ts-navy);
            text-decoration: none;
        }

            .ts-login-link:hover {
                background: var(--ts-navy);
                color: #ffffff;
                transform: translateY(-1px);
            }

        /* ═══════════════════════════════════════
                                   CONTENIDO PRINCIPAL
                                   ═══════════════════════════════════════ */

        .ts-main {
            width: 100%;
            min-width: 0;
            flex: 1 0 auto;
            opacity: 1;
        }

            .ts-main > main {
                min-width: 0;
            }

        /* ═══════════════════════════════════════
                                   FOOTER
                                   ═══════════════════════════════════════ */

        footer.ts-footer {
            flex-shrink: 0;
            margin-top: auto;
            padding: 1.25rem 2rem;
            border-top: 1px solid var(--ts-border);
            background: #ffffff;
            text-align: center;
            color: #8ab2cc;
            font-size: 0.82rem;
            letter-spacing: 1px;
            opacity: 1;
        }

            footer.ts-footer a {
                color: var(--ts-navy);
                text-decoration: none;
                font-weight: 600;
            }

                footer.ts-footer a:hover {
                    color: var(--ts-red);
                }

        /* ═══════════════════════════════════════
                                   TABLET / NOTEBOOK PEQUEÑO
                                   ═══════════════════════════════════════ */

        @@media (max-width: 1100px) {

            .ts-navbar {
                padding: 0 1rem;
            }

            .ts-brand-sub {
                display: none;
            }

            .ts-brand-title {
                font-size: 1.15rem;
                letter-spacing: 1.3px;
            }

            .ts-brand img {
                height: 44px;
            }

            .ts-navbar-right {
                gap: 0.65rem;
            }

            .ts-nav-collapse {
                gap: 0.65rem;
            }

            .ts-nav > li > .nav-link {
                padding: 0.42rem 0.65rem;
                font-size: 0.88rem;
            }

            .ts-user-area {
                gap: 0.55rem;
                padding-left: 0.7rem;
            }

            .ts-user-name {
                max-width: 130px;
                font-size: 0.84rem;
            }

            .ts-logout-button {
                padding: 0.4rem 0.7rem;
                font-size: 0.8rem;
            }
        }

        /* ═══════════════════════════════════════
                                   MÓVIL / TABLET VERTICAL
                                   ═══════════════════════════════════════ */

        @@media (max-width: 768px) {

            .ts-navbar {
                min-height: 64px;
                padding: 0.45rem 1rem;
                flex-wrap: wrap;
            }

            .ts-brand {
                gap: 8px;
            }

                .ts-brand img {
                    height: 42px;
                }

            .ts-brand-title {
                font-size: 1.05rem;
                letter-spacing: 1.1px;
            }

            .ts-brand-sub {
                display: none;
            }

            .ts-navbar-toggler {
                display: inline-flex;
            }

            .ts-navbar-right {
                width: 100%;
                display: block;
            }

            .ts-nav-collapse {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding-top: 0.7rem;
            }

                .ts-nav-collapse.collapse:not(.show) {
                    display: none;
                }

                .ts-nav-collapse.collapsing {
                    display: flex;
                    height: 0;
                    overflow: hidden;
                    transition: height 0.25s ease;
                }

                .ts-nav-collapse.collapse.show {
                    display: flex;
                }

            .ts-nav {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 0.2rem;
                padding: 0;
            }

                .ts-nav > li {
                    width: 100%;
                }

                    .ts-nav > li > .nav-link {
                        width: 100%;
                        justify-content: space-between;
                        padding: 0.65rem 0.75rem;
                        border-radius: 8px;
                        font-size: 0.95rem;
                    }

                        .ts-nav > li > .nav-link:hover,
                        .ts-nav > li > .nav-link.active {
                            transform: none;
                        }

                .ts-nav .dropdown-menu {
                    position: static !important;
                    transform: none !important;
                    width: 100%;
                    min-width: 0;
                    margin: 0.2rem 0 0.45rem;
                    padding: 0.35rem;
                    border-radius: 9px;
                    background: rgba(240, 246, 252, 0.85);
                    box-shadow: none;
                }

                .ts-nav .dropdown-item {
                    padding: 0.55rem 0.7rem;
                    font-size: 0.88rem;
                }

                    .ts-nav .dropdown-item:hover {
                        transform: none;
                    }

            .ts-dropdown-label {
                padding: 0.4rem 0.7rem 0.2rem;
            }

            .ts-user-area {
                width: 100%;
                margin-top: 0.55rem;
                padding: 0.8rem 0 0.15rem;
                justify-content: space-between;
                border-left: none;
                border-top: 1px solid var(--ts-border);
            }

            .ts-user-info {
                min-width: 0;
                text-align: left;
            }

            .ts-user-greeting {
                align-self: flex-start;
            }

            .ts-user-name {
                max-width: 190px;
                font-size: 0.88rem;
            }

            .ts-logout-button {
                white-space: nowrap;
            }

            .ts-main {
                width: 100%;
            }

            footer.ts-footer {
                padding: 1rem;
                font-size: 0.75rem;
                letter-spacing: 0.6px;
            }
        }

        /* ═══════════════════════════════════════
                                   TELÉFONOS PEQUEÑOS
                                   ═══════════════════════════════════════ */

        @@media (max-width: 430px) {

            .ts-navbar {
                padding: 0.4rem 0.75rem;
            }

            .ts-brand img {
                height: 38px;
            }

            .ts-brand-title {
                font-size: 0.95rem;
                letter-spacing: 0.8px;
            }

            .ts-navbar-toggler {
                width: 39px;
                height: 38px;
            }

            .ts-user-area {
                gap: 0.6rem;
            }

            .ts-user-name {
                max-width: 145px;
                font-size: 0.82rem;
            }

            .ts-user-greeting {
                font-size: 0.6rem;
                padding: 3px 7px;
            }

            .ts-logout-button {
                padding: 0.4rem 0.65rem;
                font-size: 0.76rem;
            }

            footer.ts-footer {
                padding: 0.9rem 0.65rem;
            }
        }

        /* ═══════════════════════════════════════
                                   TELÉFONOS MUY PEQUEÑOS
                                   ═══════════════════════════════════════ */

        @@media (max-width: 350px) {

            .ts-brand-title {
                font-size: 0.88rem;
            }

            .ts-brand img {
                height: 35px;
            }

            .ts-user-area {
                align-items: flex-start;
                flex-direction: column;
            }

            .ts-user-name {
                max-width: 100%;
            }

            .ts-logout-form,
            .ts-logout-button {
                width: 100%;
            }
        }

        /* ═══════════════════════════════════════
                                   ACCESIBILIDAD: REDUCIR MOVIMIENTO
                                   ═══════════════════════════════════════ */

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

    </style>

</head>

<body>

    <!-- ═══════════════════════════════════════
         NAVBAR
         ═══════════════════════════════════════ -->

    <header>

        <nav class="ts-navbar"
             id="tsNavbar">

            <div class="ts-gradient-bar"
                 id="tsGradientBar">
            </div>

            <!-- BRAND -->

            <a class="ts-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.png"
                     alt="Tempest Sushi Logo" />

                <div class="ts-brand-text">

                    <span class="ts-brand-title">
                        TEMPEST SUSHI
                    </span>

                    <span class="ts-brand-sub">
                        テンペスト 寿司 · REINO DE TEMPEST
                    </span>

                </div>

            </a>

            <!-- HAMBURGUESA -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="ts-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tsNavCollapse"
                        aria-controls="tsNavCollapse"
                        aria-expanded="false"
                        aria-label="Abrir menú de navegación">

                    <span class="ts-toggler-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                </button>
            }

            <div class="ts-navbar-right">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="collapse d-md-flex ts-nav-collapse"
                         id="tsNavCollapse">

                        <!-- ══════════════════════
                             MENÚ
                             ══════════════════════ -->

                        <ul class="ts-nav">

                            <!-- HOME -->

                            <li>

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-7 9 7" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" /></svg>
                                    Home

                                </a>

                            </li>

                            <!-- CATÁLOGO -->
                            @if (User.IsInRole("Cliente")
                                                    || User.IsInRole("Encargado")
                                                    || User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                                        Catálogo

                                    </a>

                                    <ul class="dropdown-menu">

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="Producto"
                                               asp-action="Index">

                                                Productos

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="Combo"
                                               asp-action="Index">

                                                Combos

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="Menu"
                                               asp-action="Index">

                                                Menús

                                            </a>

                                        </li>

                                    </ul>

                                </li>
                            }

                            <!-- PEDIDOS -->
                            @if (User.IsInRole("Cliente")
                                                    || User.IsInRole("Encargado")
                                                    || User.IsInRole("Administrador"))
                            {
                                <li>

                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="Pedido"
                                       asp-action="Index">

                                        <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2l1 4h10l1-4" /><rect x="4" y="6" width="16" height="16" rx="2" /><path d="M9 11h6M9 15h6" /></svg>
                                        Pedidos

                                        <span id="ts-pedido-badge"
                                              class="ts-cart-badge"
                                              style="display:none;">
                                            0
                                        </span>

                                    </a>

                                </li>
                            }

                            <!-- CARRITO (solo Cliente) -->
                            @if (User.IsInRole("Cliente"))
                            {
                                <li>

                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="Carrito"
                                       asp-action="Index">

                                        <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none" /><circle cx="17" cy="20" r="1.4" fill="currentColor" stroke="none" /><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 7H6" /></svg>
                                        Carrito

                                        <span id="ts-carrito-badge"
                                              class="ts-cart-badge"
                                              style="display:none;">
                                            0
                                        </span>

                                    </a>

                                </li>
                            }

                            <!-- COCINA -->
                            @if (User.IsInRole("Cocina")
                                                    || User.IsInRole("Administrador"))
                            {
                                <li>

                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="ProcesoPreparacion"
                                       asp-action="Index">

                                        <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 3v7a4 4 0 0 0 8 0V3" /><path d="M8 10v11" /><path d="M18 3c-2 2-2 5 0 7v11" /></svg>
                                        Cocina

                                    </a>

                                </li>
                            }

                            <!-- ADMINISTRACIÓN -->
                            @if (User.IsInRole("Administrador")
                                                    || User.IsInRole("Encargado"))
                            {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        <svg class="ts-nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                                        Administración

                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        @if (User.IsInRole("Encargado")
                                                                        || User.IsInRole("Administrador"))
                                        {
                                            <li>

                                                <a class="dropdown-item"
                                                   asp-area=""
                                                   asp-controller="Reporte"
                                                   asp-action="Index">

                                                    Reportes

                                                </a>

                                            </li>
                                        }

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <li>

                                                <a class="dropdown-item"
                                                   asp-area=""
                                                   asp-controller="Usuario"
                                                   asp-action="Index">

                                                    Usuarios

                                                </a>

                                            </li>
                                        }

                                    </ul>

                                </li>
                            }

                        </ul>

                        <!-- ══════════════════════
                             USUARIO
                             ══════════════════════ -->

                        <div class="ts-user-area">

                            <div class="ts-user-info">

                                <span class="ts-user-greeting @claseRol">
                                    @rolUsuario
                                </span>

                                <span class="ts-user-name"
                                      title="@User.Identity.Name">

                                    @User.Identity.Name

                                </span>

                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="ts-logout-form">

                                <button type="submit"
                                        class="ts-logout-button">

                                    Cerrar sesión

                                </button>

                            </form>

                        </div>

                    </div>
                }
                else if (!esPaginaLogin)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="ts-login-link">

                        Iniciar sesión

                    </a>
                }

            </div>

        </nav>

    </header>

    <!-- ═══════════════════════════════════════
         CONTENIDO
         ═══════════════════════════════════════ -->

    <div class="container ts-main"
         id="tsMain">

        <main role="main"
              class="pb-4 pt-3">

            @RenderBody()

        </main>

    </div>

    <!-- ═══════════════════════════════════════
         MODALES
         ═══════════════════════════════════════ -->
    @await RenderSectionAsync(
    "Modals",
        required: false)

    <!-- ═══════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════ -->

    <footer class="ts-footer"
            id="tsFooter">

        &copy; 2026 —

        <strong>
            TempestSushi
        </strong>

        &nbsp;·&nbsp;

        <a asp-area=""
           asp-controller="Home"
           asp-action="Privacy">

            Privacy

        </a>

    </footer>

    <!-- ═══════════════════════════════════════
         SCRIPTS
         ═══════════════════════════════════════ -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/carrito.js"
            asp-append-version="true">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <script>

        /* ═══════════════════════════════════════
           ANIMACIONES
           ═══════════════════════════════════════ */

        if (typeof anime !== 'undefined') {

            anime({
                targets: '#tsNavbar',
                translateY: [-35, 0],
                opacity: [0, 1],
                duration: 600,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '#tsMain',
                translateY: [18, 0],
                opacity: [0, 1],
                duration: 650,
                delay: 120,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '#tsFooter',
                opacity: [0, 1],
                duration: 500,
                delay: 250,
                easing: 'easeOutSine'
            });

            anime({
                targets: '#tsGradientBar',
                width: ['60px', '100%'],
                duration: 850,
                delay: 100,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.ts-brand img',
                translateY: [
                    {
                        value: -4,
                        duration: 1300
                    },
                    {
                        value: 0,
                        duration: 1300
                    }
                ],
                loop: true,
                easing: 'easeInOutSine'
            });

            anime({
                targets: '.ts-user-greeting',
                opacity: [0, 1],
                scale: [0.9, 1],
                delay: 350,
                duration: 450,
                easing: 'easeOutBack'
            });
        }

        /* ═══════════════════════════════════════
           MARCAR RUTA ACTIVA
           ═══════════════════════════════════════ */

        (function markActiveNav() {

            const path =
                window.location.pathname
                    .toLowerCase();

            document
                .querySelectorAll(
                    '.ts-nav a[href]'
                )
                .forEach(function (link) {

                    const href =
                        link.getAttribute('href') || '';

                    if (!href ||
                        href === '#') {
                        return;
                    }

                    const normalizado =
                        href.toLowerCase();

                    const coincide =
                        normalizado === '/'
                            ? path === '/'
                            : path.startsWith(
                                normalizado
                            );

                    if (!coincide) {
                        return;
                    }

                    link.classList.add(
                        'active'
                    );

                    const dropdown =
                        link.closest(
                            '.dropdown'
                        );

                    if (dropdown) {

                        const toggle =
                            dropdown.querySelector(
                                '.dropdown-toggle'
                            );

                        if (toggle) {
                            toggle.classList.add(
                                'active'
                            );
                        }
                    }
                });

        })();

        /* ═══════════════════════════════════════
           ANIMACIÓN DE LINKS
           ═══════════════════════════════════════ */

        if (typeof anime !== 'undefined') {

            document
                .querySelectorAll(
                    '.ts-nav > li > .nav-link'
                )
                .forEach(function (link) {

                    link.addEventListener(
                        'click',
                        function () {

                            anime({
                                targets: link,
                                scale: [
                                    1,
                                    1.04,
                                    1
                                ],
                                duration: 230,
                                easing: 'easeOutQuad'
                            });

                        });

                });
        }

        /* ═══════════════════════════════════════
           HAMBURGUESA: TRANSFORMAR A X
           ═══════════════════════════════════════ */

        (function configurarToggler() {

            const toggler =
                document.querySelector('.ts-navbar-toggler');

            const collapseElement =
                document.getElementById('tsNavCollapse');

            if (!toggler || !collapseElement) {
                return;
            }

            collapseElement.addEventListener('show.bs.collapse', function () {
                toggler.classList.add('ts-toggler-open');
            });

            collapseElement.addEventListener('hide.bs.collapse', function () {
                toggler.classList.remove('ts-toggler-open');
            });

        })();

        /* ═══════════════════════════════════════
           DROPDOWNS: ANIMACIÓN DE APERTURA
           ═══════════════════════════════════════ */

        if (typeof anime !== 'undefined') {

            document.addEventListener('show.bs.dropdown', function (evento) {

                const menu =
                    evento.target.nextElementSibling ||
                    evento.target.parentElement.querySelector('.dropdown-menu');

                if (!menu) {
                    return;
                }

                anime({
                    targets: menu,
                    opacity: [0, 1],
                    translateY: [-8, 0],
                    scale: [0.97, 1],
                    duration: 220,
                    easing: 'easeOutQuad'
                });

            });
        }



        (function configurarMenuMovil() {

            const collapseElement =
                document.getElementById(
                    'tsNavCollapse'
                );

            if (!collapseElement) {
                return;
            }

            document
                .querySelectorAll(
                    '#tsNavCollapse .dropdown-item, #tsNavCollapse > .ts-nav > li > .nav-link:not(.dropdown-toggle)'
                )
                .forEach(function (link) {

                    link.addEventListener(
                        'click',
                        function () {

                            if (
                                window.innerWidth >
                                768
                            ) {
                                return;
                            }

                            const instancia =
                                bootstrap.Collapse
                                    .getInstance(
                                        collapseElement
                                    );

                            if (instancia) {
                                instancia.hide();
                            }

                        });

                });

        })();

    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>