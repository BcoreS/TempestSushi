@using System.Security.Claims

@{
    var rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value;

    var esPaginaLogin =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Account"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Login";

    var claseRol = rolUsuario switch
    {
        "Administrador" => "ts-role-admin",
        "Encargado" => "ts-role-encargado",
        "Cocina" => "ts-role-cocina",
        "Cliente" => "ts-role-cliente",
        _ => "ts-role-default"
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TempestSushi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <style>
        /* ── Colores del logo ──────────────────────────────────────
                   Azul marino : #1a3a6e   (TEMPEST text, bordes fuertes)
                   Azul cielo  : #4fa8e8   (SUSHI text, acentos, olas)
                   Rojo        : #c0392b   (sello 嵐, hover activo)
                ────────────────────────────────────────────────────────── */

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'Noto Sans JP', sans-serif;
            background: #f0f6fc;
            margin: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: 'Noto Sans JP', sans-serif;
            background: #f0f6fc;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        /* ── NAVBAR ───────────────────────────────────────────── */
        .ts-navbar {
            background: #ffffff;
            border-bottom: 2px solid #1a3a6e;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 72px;
            position: relative;
            box-shadow: 0 2px 12px rgba(26, 58, 110, 0.10);
            opacity: 0; /* Anime.js lo revela */
        }

        /* Línea animada debajo del borde */
        .ts-gradient-bar {
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 60px; /* Anime.js la expande */
            height: 3px;
            background: linear-gradient(90deg, #1a3a6e, #4fa8e8, #c0392b);
            border-radius: 2px;
        }

        /* ── BRAND ────────────────────────────────────────────── */
        .ts-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

            .ts-brand img {
                height: 52px;
                width: auto;
                filter: drop-shadow(0 2px 6px rgba(26, 58, 110, 0.18));
            }

        .ts-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .ts-brand-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a3a6e;
            letter-spacing: 2px;
        }

        .ts-brand-sub {
            font-size: 0.62rem;
            color: #4fa8e8;
            letter-spacing: 3px;
            font-weight: 500;
            margin-top: 2px;
        }

        /* ── NAV LINKS ────────────────────────────────────────── */
        .ts-nav {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .ts-main {
            opacity: 0;
            flex: 1 0 auto;
            width: 100%;
        }

            .ts-nav li a {
                font-family: 'Rajdhani', sans-serif;
                font-size: 1rem;
                font-weight: 600;
                font-weight: 600;
                color: #1a3a6e;
                text-decoration: none;
                padding: 6px 14px;
                border-radius: 6px;
                letter-spacing: 1px;
                position: relative;
                transition: color .2s, background .2s;
            }

                .ts-nav li a::after {
                    content: '';
                    position: absolute;
                    bottom: 2px;
                    left: 50%;
                    right: 50%;
                    height: 2px;
                    background: #c0392b;
                    transition: left .25s, right .25s;
                    border-radius: 2px;
                }

                .ts-nav li a:hover,
                .ts-nav li a.active {
                    color: #c0392b;
                    background: rgba(192, 57, 43, 0.07);
                }

                .ts-nav li a:hover::after,
                .ts-nav li a.active::after {
                    left: 12%;
                    right: 12%;
                }

        .ts-cart-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            margin-left: 4px;
            border-radius: 999px;
            background: #c0392b;
            color: #fff;
            font-size: 0.68rem;
            font-weight: 700;
            font-family: 'Rajdhani', sans-serif;
            vertical-align: middle;
        }

        /* ── FOOTER ───────────────────────────────────────────── */
        footer.ts-footer {
            border-top: 2px solid #d0e8f8;
            background: #fff;
            padding: 1.25rem 2rem;
            text-align: center;
            color: #8ab2cc;
            font-size: .85rem;
            letter-spacing: 1px;
            opacity: 0;
            flex-shrink: 0;
            margin-top: auto;
        }

            footer.ts-footer a {
                color: #1a3a6e;
                text-decoration: none;
                font-weight: 600;
            }

        /* ── CONTENIDO PRINCIPAL ──────────────────────────────── */
        .ts-main {
            opacity: 0; /* Anime.js lo revela */
        }

        /* ── RESPONSIVE: ocultar sub-brand en móvil ───────────── */
        @@media (max-width: 576px) {
            .ts-brand-sub {
                display: none;
            }

            .ts-brand-title {
                font-size: 1.1rem;
            }

            .ts-navbar {
                padding: 0 1rem;
            }
        }

        /*Estilos nuevos de avance 5 */

        .ts-navbar-right {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .ts-user-area {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            padding-left: 1rem;
            border-left: 1px solid #d0e8f8;
        }

        .ts-user-info {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            text-align: right;
        }

        .ts-user-greeting {
            align-self: flex-end;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-radius: 999px;
            padding: 3px 9px;
            margin-bottom: 3px;
            white-space: nowrap;
            box-shadow: 0 2px 7px rgba(0, 0, 0, 0.15);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .ts-user-greeting:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.20);
            }

        /* ── Roles de usuario ───────────────────────────────── */

        .ts-role-admin {
            background: #c0392b;
        }

        .ts-role-encargado {
            background: #1a3a6e;
        }

        .ts-role-cocina {
            background: #d68910;
        }

        .ts-role-cliente {
            background: #3498db;
        }

        .ts-role-default {
            background: #6c757d;
        }
        .ts-user-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            color: #1a3a6e;
            white-space: nowrap;
        }

        .ts-logout-form {
            margin: 0;
        }

        .ts-logout-button,
        .ts-login-link {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            border-radius: 999px;
            padding: 0.45rem 1rem;
            transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }

        .ts-logout-button {
            border: 1px solid rgba(192, 57, 43, 0.35);
            background: rgba(192, 57, 43, 0.06);
            color: #c0392b;
            cursor: pointer;
        }

            .ts-logout-button:hover {
                background: #c0392b;
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 5px 14px rgba(192, 57, 43, 0.2);
            }

        .ts-login-link {
            border: 1px solid rgba(26, 58, 110, 0.25);
            color: #1a3a6e;
            text-decoration: none;
        }

            .ts-login-link:hover {
                background: #1a3a6e;
                color: #ffffff;
                transform: translateY(-1px);
            }
    </style>
</head>
<body>

    <!-- ══ NAVBAR ══════════════════════════════════════════════ -->
    <header>
        <nav class="ts-navbar" id="tsNavbar">
            <div class="ts-gradient-bar" id="tsGradientBar"></div>

            <a class="ts-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.png"
                     alt="Tempest Sushi Logo" />

                <div class="ts-brand-text">
                    <span class="ts-brand-title">
                        TEMPEST SUSHI
                    </span>

                    <span class="ts-brand-sub">
                        テンペスト 寿司 &nbsp;·&nbsp; REINO DE TEMPEST
                    </span>
                </div>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler d-sm-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tsNavCollapse"
                        aria-controls="tsNavCollapse"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>
                </button>
            }

            <div class="ts-navbar-right">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="ts-nav collapse d-sm-flex"
                        id="tsNavCollapse">

                        <!-- Todos los usuarios autenticados -->
                        <li>
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- Cliente, Encargado y Administrador -->
                        @if (User.IsInRole("Cliente")
                                            || User.IsInRole("Encargado")
                                            || User.IsInRole("Administrador"))
                        {
                            <li>
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Producto"
                                   asp-action="Index">
                                    Productos
                                </a>
                            </li>

                            <li>
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Combo"
                                   asp-action="Index">
                                    Combos
                                </a>
                            </li>

                            <li>
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Menu"
                                   asp-action="Index">
                                    Menús
                                </a>
                            </li>

                            <li>
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Pedido"
                                   asp-action="Index">
                                    Pedidos
                                    <span id="ts-cart-badge" class="ts-cart-badge" style="display:none;">0</span>
                                </a>
                            </li>
                        }

                        <!-- Cocina y Administrador -->
                        @if (User.IsInRole("Cocina")
                                            || User.IsInRole("Administrador"))
                        {
                            <li>
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="ProcesoPreparacion"
                                   asp-action="Index">
                                    Preparación
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="ts-user-area">

                        <div class="ts-user-info">

                            <span class="ts-user-greeting @claseRol">
                                @rolUsuario
                            </span>

                            <span class="ts-user-name">
                                @User.Identity.Name
                            </span>

                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="ts-logout-form">

                            <button type="submit"
                                    class="ts-logout-button">
                                Cerrar sesión
                            </button>

                        </form>

                    </div>
                }
                else if (!esPaginaLogin)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="ts-login-link">
                        Iniciar sesión
                    </a>
                }

            </div>
        </nav>
    </header>

    <!-- ══ CONTENIDO ═══════════════════════════════════════════ -->
    <div class="container ts-main" id="tsMain">
        <main role="main" class="pb-4 pt-3">
            @RenderBody()
        </main>
    </div>

    <!-- ══ MODALES DE LAS VISTAS ═══════════════════════════════ -->
    @await RenderSectionAsync("Modals", required: false)

    <!-- ══ FOOTER ══════════════════════════════════════════════ -->
    <footer class="ts-footer" id="tsFooter">
        &copy; 2026 — <strong>TempestSushi</strong> &nbsp;·&nbsp;
        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    <!-- ══ SCRIPTS ═════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── Entrada de página ─────────────────────────────────
        anime({
            targets: '#tsNavbar',
            translateY: [-64, 0],
            opacity: [0, 1],
            duration: 700,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '#tsMain',
            translateY: [24, 0],
            opacity: [0, 1],
            duration: 700,
            delay: 250,
            easing: 'easeOutExpo'
        });

        anime({
            targets: '#tsFooter',
            opacity: [0, 1],
            duration: 600,
            delay: 450,
            easing: 'easeOutSine'
        });

        // ── Barra de degradado animada ────────────────────────
        anime({
            targets: '#tsGradientBar',
            width: ['60px', '100%'],
            duration: 900,
            delay: 200,
            easing: 'easeOutExpo'
        });

        // ── Logo flotando suavemente ──────────────────────────
        anime({
            targets: '.ts-brand img',
            translateY: [{ value: -5, duration: 1200 }, { value: 0, duration: 1200 }],
            loop: true,
            easing: 'easeInOutSine'
        });

        // ── Animación del badge de rol de usuario Login ──────────────────────────

                anime({
            targets: '.ts-user-greeting',
            opacity: [0, 1],
            scale: [0.85, 1],
            delay: 500,
            duration: 500,
            easing: 'easeOutBack'
        });

        // ── Marca el nav-link activo según la URL ─────────────
        (function markActiveNav() {
            const path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.ts-nav .nav-link').forEach(function (a) {
                const href = a.getAttribute('href') || '';
                if (href === '/' ? path === '/' : path.startsWith(href.toLowerCase())) {
                    a.classList.add('active');
                }
            });
        })();

        // ── Ripple suave al hacer clic en nav-link ────────────
        document.querySelectorAll('.ts-nav .nav-link').forEach(function (a) {
            a.addEventListener('click', function () {
                anime({
                    targets: a,
                    scale: [1, 1.08, 1],
                    duration: 320,
                    easing: 'easeOutQuad'
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
