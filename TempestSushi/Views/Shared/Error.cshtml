@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<style>
    .error-page {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 0 3rem;
    }

    .error-card {
        background: #ffffff;
        border: 1.5px solid #d0e8f8;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(26, 58, 110, 0.09);
        text-align: center;
    }

    .error-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff1ef;
        color: #c0392b;
        font-size: 2rem;
    }

    .error-title {
        margin-bottom: 0.5rem;
        font-family: 'Rajdhani', sans-serif;
        font-size: clamp(1.8rem, 5vw, 2.3rem);
        font-weight: 700;
        color: #1a3a6e;
        line-height: 1.2;
    }

    .error-subtitle {
        max-width: 560px;
        margin: 0 auto 1.5rem;
        color: #6489a3;
        font-size: 0.98rem;
        line-height: 1.6;
    }

    .error-request {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 6px;
        max-width: 100%;
        margin-bottom: 1.5rem;
        padding: 0.65rem 1rem;
        border-radius: 8px;
        background: #f0f6fc;
        color: #1a3a6e;
        font-size: 0.85rem;
    }

        .error-request code {
            max-width: 100%;
            color: #c0392b;
            overflow-wrap: anywhere;
        }

    .error-divider {
        margin: 1.5rem 0;
        border: none;
        border-top: 1px solid #d0e8f8;
    }

    .error-help-title {
        margin-bottom: 0.45rem;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a3a6e;
    }

    .error-help {
        margin-bottom: 1.5rem;
        color: #6489a3;
        font-size: 0.9rem;
        line-height: 1.55;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .error-btn-primary,
    .error-btn-secondary {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1.4rem;
        border-radius: 8px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

    .error-btn-primary {
        border: 1.5px solid #1a3a6e;
        background: #1a3a6e;
        color: #ffffff !important;
    }

        .error-btn-primary:hover {
            background: #c0392b;
            border-color: #c0392b;
            transform: translateY(-1px);
        }

    .error-btn-secondary {
        border: 1.5px solid #1a3a6e;
        background: #ffffff;
        color: #1a3a6e;
    }

        .error-btn-secondary:hover {
            background: #e8f4fd;
            color: #1a3a6e;
            transform: translateY(-1px);
        }

    @@media (max-width: 576px) {

        .error-page {
            padding: 1rem 0 2rem;
        }

        .error-card {
            padding: 1.75rem 1.2rem;
            border-radius: 14px;
        }

        .error-icon {
            width: 62px;
            height: 62px;
            font-size: 1.7rem;
        }

        .error-title {
            font-size: 1.7rem;
        }

        .error-subtitle {
            font-size: 0.92rem;
        }

        .error-actions {
            flex-direction: column;
        }

        .error-btn-primary,
        .error-btn-secondary {
            width: 100%;
            min-height: 46px;
        }
    }

    @@media (max-width: 390px) {

        .error-card {
            padding: 1.5rem 1rem;
        }

        .error-title {
            font-size: 1.55rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .error-btn-primary,
        .error-btn-secondary {
            transition: none;
        }
    }
</style>

<div class="error-page">

    <div class="error-card">

        <div class="error-icon"
             aria-hidden="true">

            ⚠️

        </div>

        <h1 class="error-title">
            Ocurrió un error
        </h1>

        <p class="error-subtitle">

            No fue posible completar la solicitud.
            Puedes regresar al inicio o intentar nuevamente
            desde la sección anterior.

        </p>

        @if (Model.ShowRequestId)
        {
            <div class="error-request">

                <strong>
                    ID de solicitud:
                </strong>

                <code>
                    @Model.RequestId
                </code>

            </div>
        }

        <hr class="error-divider" />

        <div class="error-help-title">
            ¿Qué puedes hacer?
        </div>

        <p class="error-help">

            Si el problema continúa, utiliza el ID de solicitud mostrado
            arriba para identificar el error durante la revisión del sistema.

        </p>

        <div class="error-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="error-btn-primary">

                Volver al inicio

            </a>

            <a href="javascript:history.back()"
               class="error-btn-secondary">

                Regresar

            </a>

        </div>

    </div>

</div>