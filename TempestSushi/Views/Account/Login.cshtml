@model TempestSushi.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet">

<style>
    :root {
        --login-ink: #0a1128;
        --login-abyss: #0d1b3e;
        --login-foam: #e8edf5;
        --login-vermillion: #c41e3a;
        --login-gold: #d4af37;
    }

    /* ═══════════════════════════════════════
           CONTENEDOR GENERAL
           ═══════════════════════════════════════ */

    .ts-login-page {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        min-height: 680px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(2.5rem, 6vh, 4.5rem) 1.5rem;
        overflow: hidden;
        background: radial-gradient( ellipse at 50% -10%, rgba(196, 30, 58, 0.20), transparent 52% ), radial-gradient( circle at 85% 75%, rgba(79, 168, 232, 0.08), transparent 34% ), linear-gradient( 180deg, var(--login-ink) 0%, var(--login-abyss) 64%, #142454 100% );
    }

        .ts-login-page::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient( 115deg, transparent 0%, rgba(255, 255, 255, 0.018) 50%, transparent 100% );
        }

    .ts-login-wrapper {
        position: relative;
        z-index: 1;
        width: min(100%, 440px);
        margin: 0 auto;
    }

    /* ═══════════════════════════════════════
           BRAND
           ═══════════════════════════════════════ */

    .ts-login-brand {
        text-align: center;
        margin-bottom: 1.8rem;
    }

    .ts-login-kicker {
        margin-bottom: 0.6rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: var(--login-vermillion);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .ts-login-title {
        margin: 0;
        font-family: 'Bodoni Moda', serif;
        font-size: clamp(2.6rem, 5vw, 3.8rem);
        font-weight: 700;
        line-height: 0.98;
        letter-spacing: -0.02em;
        color: var(--login-foam);
    }

        .ts-login-title span {
            color: var(--login-gold);
            font-style: italic;
        }

    .ts-accent-line {
        width: 64px;
        height: 2px;
        margin: 1rem auto 0;
        border-radius: 999px;
        background: linear-gradient( 90deg, transparent, var(--login-vermillion), transparent );
    }

    .ts-login-subtitle {
        margin: 0.8rem 0 0;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.92rem;
        color: rgba(232, 237, 245, 0.64);
    }

    /* ═══════════════════════════════════════
           CARD
           ═══════════════════════════════════════ */

    .ts-login-card {
        width: 100%;
        padding: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.055);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    /* ═══════════════════════════════════════
           FORMULARIO
           ═══════════════════════════════════════ */

    .ts-form-group {
        margin-bottom: 1.25rem;
    }

    .ts-label {
        display: block;
        margin-bottom: 0.5rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.84rem;
        font-weight: 500;
        color: var(--login-foam);
    }

    .ts-input {
        width: 100%;
        min-height: 48px;
        padding: 0.8rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 12px;
        outline: none;
        background: rgba(255, 255, 255, 0.065);
        color: var(--login-foam);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.95rem;
        transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
    }

        .ts-input::placeholder {
            color: rgba(232, 237, 245, 0.34);
        }

        .ts-input:hover {
            border-color: rgba(255, 255, 255, 0.20);
        }

        .ts-input:focus {
            border-color: var(--login-gold);
            background: rgba(255, 255, 255, 0.085);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.11);
        }

    .ts-validation {
        display: block;
        margin-top: 0.4rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.78rem;
        line-height: 1.4;
        color: #ff91a4;
    }

    /* ═══════════════════════════════════════
           ALERTAS
           ═══════════════════════════════════════ */

    .ts-summary,
    .ts-success {
        margin-bottom: 1.25rem;
        padding: 0.78rem 0.95rem;
        border-radius: 10px;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.83rem;
        line-height: 1.45;
    }

    .ts-summary {
        color: #ff9aaa;
        background: rgba(196, 30, 58, 0.10);
        border: 1px solid rgba(196, 30, 58, 0.25);
    }

        .ts-summary:empty {
            display: none;
        }

    .ts-success {
        color: #b8f3c7;
        background: rgba(39, 174, 96, 0.12);
        border: 1px solid rgba(39, 174, 96, 0.30);
    }

    /* ═══════════════════════════════════════
           RECORDARME
           ═══════════════════════════════════════ */

    .ts-check-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1.45rem;
    }

        .ts-check-row input {
            width: 1rem;
            height: 1rem;
            margin-top: 0;
            accent-color: var(--login-vermillion);
            cursor: pointer;
        }

    .ts-check-label {
        margin: 0;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.72);
        font-size: 0.86rem;
        cursor: pointer;
        user-select: none;
    }

    /* ═══════════════════════════════════════
           BOTÓN LOGIN
           ═══════════════════════════════════════ */

    .ts-login-button {
        width: 100%;
        min-height: 49px;
        padding: 0.85rem 1.5rem;
        border: none;
        border-radius: 999px;
        background: var(--login-vermillion);
        color: var(--login-foam);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        cursor: pointer;
        box-shadow: 0 10px 28px rgba(196, 30, 58, 0.33);
        transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
    }

        .ts-login-button:hover {
            transform: translateY(-2px);
            background: #d52443;
            box-shadow: 0 14px 34px rgba(196, 30, 58, 0.42);
        }

        .ts-login-button:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.22), 0 12px 30px rgba(196, 30, 58, 0.36);
        }

        .ts-login-button:active {
            transform: translateY(0);
        }

    /* ═══════════════════════════════════════
           REGISTRO
           ═══════════════════════════════════════ */

    .ts-login-register {
        margin-top: 1.2rem;
        text-align: center;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.60);
        font-size: 0.86rem;
        line-height: 1.5;
    }

        .ts-login-register a {
            color: var(--login-gold);
            text-decoration: none;
            font-weight: 700;
            transition: color 0.2s ease, text-decoration-color 0.2s ease;
        }

            .ts-login-register a:hover {
                color: #f0cf5f;
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .ts-login-register a:focus-visible {
                outline: 2px solid rgba(212, 175, 55, 0.65);
                outline-offset: 3px;
                border-radius: 3px;
            }

    /* ═══════════════════════════════════════
           TEXTO INFERIOR
           ═══════════════════════════════════════ */

    .ts-login-footer {
        margin-top: 1.25rem;
        text-align: center;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.38);
        font-size: 0.75rem;
        line-height: 1.45;
    }

    /* ═══════════════════════════════════════
           TABLET
           ═══════════════════════════════════════ */

    @@media (max-width: 768px) {

        .ts-login-page {
            min-height: 620px;
            padding: 3rem 1.25rem;
        }

        .ts-login-wrapper {
            max-width: 420px;
        }

        .ts-login-brand {
            margin-bottom: 1.6rem;
        }

        .ts-login-title {
            font-size: clamp( 2.45rem, 10vw, 3.25rem );
        }
    }

    /* ═══════════════════════════════════════
           MÓVIL
           ═══════════════════════════════════════ */

    @@media (max-width: 576px) {

        .ts-login-page {
            min-height: 580px;
            padding: 2.2rem 1rem;
        }

        .ts-login-wrapper {
            max-width: 400px;
        }

        .ts-login-brand {
            margin-bottom: 1.35rem;
        }

        .ts-login-kicker {
            margin-bottom: 0.5rem;
            font-size: 0.68rem;
            letter-spacing: 0.15em;
        }

        .ts-login-title {
            font-size: clamp( 2.2rem, 11vw, 2.9rem );
        }

        .ts-login-subtitle {
            margin-top: 0.65rem;
            font-size: 0.86rem;
        }

        .ts-accent-line {
            margin-top: 0.8rem;
            width: 54px;
        }

        .ts-login-card {
            padding: 1.5rem 1.25rem;
            border-radius: 18px;
        }

        .ts-form-group {
            margin-bottom: 1.1rem;
        }

        .ts-check-row {
            margin-bottom: 1.25rem;
        }

        .ts-login-register {
            margin-top: 1.05rem;
            font-size: 0.82rem;
        }

        .ts-login-footer {
            margin-top: 1rem;
            font-size: 0.7rem;
        }
    }

    /* ═══════════════════════════════════════
           TELÉFONO PEQUEÑO
           ═══════════════════════════════════════ */

    @@media (max-width: 390px) {

        .ts-login-page {
            padding: 1.8rem 0.8rem;
        }

        .ts-login-card {
            padding: 1.35rem 1rem;
        }

        .ts-login-title {
            font-size: 2.15rem;
        }

        .ts-login-kicker {
            font-size: 0.64rem;
        }

        .ts-input {
            padding: 0.76rem 0.85rem;
            font-size: 0.9rem;
        }

        .ts-login-button {
            font-size: 0.88rem;
        }
    }

    /* ═══════════════════════════════════════
           PANTALLAS DE POCA ALTURA
           ═══════════════════════════════════════ */

    @@media (max-height: 720px) and (min-width: 577px) {

        .ts-login-page {
            align-items: flex-start;
            min-height: 0;
            padding: 2rem 1.5rem 2.5rem;
        }

        .ts-login-brand {
            margin-bottom: 1.25rem;
        }

        .ts-login-title {
            font-size: 2.8rem;
        }

        .ts-login-subtitle {
            margin-top: 0.55rem;
        }

        .ts-login-card {
            padding: 1.6rem;
        }

        .ts-form-group {
            margin-bottom: 1rem;
        }

        .ts-check-row {
            margin-bottom: 1.15rem;
        }
    }

    /* ═══════════════════════════════════════
           MOVIMIENTO REDUCIDO
           ═══════════════════════════════════════ */

    @@media (prefers-reduced-motion: reduce) {

        .ts-login-button,
        .ts-input,
        .ts-login-register a {
            transition: none;
        }
    }

</style>

<section class="ts-login-page">

    <div class="ts-login-wrapper">

        <!-- BRAND -->

        <div class="ts-login-brand">

            <div class="ts-login-kicker">
                Acceso al sistema
            </div>

            <h1 class="ts-login-title">
                TEMPEST <span>SUSHI</span>
            </h1>

            <div class="ts-accent-line">
            </div>

            <p class="ts-login-subtitle">
                Inicia sesión para continuar.
            </p>

        </div>

        <!-- CARD -->

        <div class="ts-login-card">

            @if (TempData["RegistroExitoso"] != null)
            {
                <div class="ts-success"
                     role="status">

                    @TempData["RegistroExitoso"]

                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="ts-summary"
                     role="alert">
                </div>

                <!-- CORREO -->

                <div class="ts-form-group">

                    <label asp-for="Correo"
                           class="ts-label">
                    </label>

                    <input asp-for="Correo"
                           class="ts-input"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="correo@ejemplo.com" />

                    <span asp-validation-for="Correo"
                          class="ts-validation">
                    </span>

                </div>

                <!-- PASSWORD -->

                <div class="ts-form-group">

                    <label asp-for="Password"
                           class="ts-label">
                    </label>

                    <input asp-for="Password"
                           class="ts-input"
                           autocomplete="current-password"
                           placeholder="Ingrese su contraseña" />

                    <span asp-validation-for="Password"
                          class="ts-validation">
                    </span>

                </div>

                <!-- RECORDARME -->

                <div class="ts-check-row">

                    <input asp-for="Recordarme"
                           class="form-check-input" />

                    <label asp-for="Recordarme"
                           class="ts-check-label">
                    </label>

                </div>

                <!-- LOGIN -->

                <button type="submit"
                        class="ts-login-button">

                    Iniciar sesión

                </button>

            </form>

            <!-- REGISTRO -->

            <div class="ts-login-register">

                ¿Aún no tienes una cuenta?

                <a asp-controller="Account"
                   asp-action="Register">

                    Crear cuenta

                </a>

            </div>

        </div>

        <!-- FOOTER DEL LOGIN -->

        <div class="ts-login-footer">

            TempestSushi · Cocina de tormenta,
            precisión de mar

        </div>

    </div>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        if (typeof anime !== 'undefined'
            && !window.matchMedia(
                '(prefers-reduced-motion: reduce)'
            ).matches) {

            anime({
                targets: '.ts-login-brand',
                opacity: [0, 1],
                translateY: [-12, 0],
                duration: 600,
                easing: 'easeOutQuad'
            });

            anime({
                targets: '.ts-login-card',
                opacity: [0, 1],
                translateY: [18, 0],
                scale: [0.985, 1],
                delay: 130,
                duration: 650,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.ts-login-footer',
                opacity: [0, 1],
                delay: 400,
                duration: 450,
                easing: 'linear'
            });
        }

    </script>

}