@model TempestSushi.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0a1128;
        --abyss: #0d1b3e;
        --foam: #e8edf5;
        --vermillion: #c41e3a;
        --gold: #d4af37;
    }

    .ts-login-page {
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        width: 100vw;
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1.5rem;
        background: radial-gradient( ellipse at 50% 0%, rgba(196, 30, 58, 0.18), transparent 55% ), linear-gradient( 180deg, var(--ink) 0%, var(--abyss) 65%, #142454 100% );
    }

    .ts-login-wrapper {
        width: 100%;
        max-width: 440px;
    }

    .ts-login-brand {
        text-align: center;
        margin-bottom: 2rem;
    }

    .ts-login-kicker {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: var(--vermillion);
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 0.65rem;
    }

    .ts-login-title {
        font-family: 'Bodoni Moda', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 1;
        color: var(--foam);
        margin: 0;
    }

        .ts-login-title span {
            color: var(--gold);
            font-style: italic;
        }

    .ts-login-subtitle {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.65);
        margin-top: 0.8rem;
        font-size: 0.95rem;
    }

    .ts-login-card {
        background: rgba(255, 255, 255, 0.055);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.32);
    }

    .ts-form-group {
        margin-bottom: 1.35rem;
    }

    .ts-label {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--foam);
        margin-bottom: 0.5rem;
        display: block;
    }

    .ts-input {
        width: 100%;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.13);
        background: rgba(255, 255, 255, 0.065);
        color: var(--foam);
        padding: 0.85rem 1rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        outline: none;
        transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

        .ts-input::placeholder {
            color: rgba(232, 237, 245, 0.35);
        }

        .ts-input:focus {
            border-color: var(--gold);
            background: rgba(255, 255, 255, 0.085);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.10);
        }

    .ts-validation {
        display: block;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.8rem;
        margin-top: 0.4rem;
        color: #ff8c9f;
    }

    .ts-summary {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.85rem;
        color: #ff9aaa;
        background: rgba(196, 30, 58, 0.10);
        border: 1px solid rgba(196, 30, 58, 0.25);
        border-radius: 10px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.3rem;
    }

        .ts-summary:empty {
            display: none;
        }

    .ts-check-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1.5rem;
    }

        .ts-check-row input {
            accent-color: var(--vermillion);
        }

    .ts-check-label {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.72);
        font-size: 0.88rem;
        cursor: pointer;
    }

    .ts-login-button {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 0.9rem 1.5rem;
        background: var(--vermillion);
        color: var(--foam);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-weight: 700;
        letter-spacing: 0.04em;
        box-shadow: 0 10px 28px rgba(196, 30, 58, 0.35);
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

        .ts-login-button:hover {
            transform: translateY(-2px);
            background: #d52443;
            box-shadow: 0 14px 34px rgba(196, 30, 58, 0.45);
        }

    .ts-login-footer {
        text-align: center;
        margin-top: 1.4rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.42);
        font-size: 0.78rem;
    }

    .ts-accent-line {
        width: 65px;
        height: 2px;
        background: var(--vermillion);
        margin: 1rem auto 0;
        border-radius: 10px;
    }

    @@media (max-width: 576px) {
        .ts-login-page {
            padding: 2.5rem 1rem;
        }

        .ts-login-card {
            padding: 1.5rem;
        }
    }
</style>

<section class="ts-login-page">

    <div class="ts-login-wrapper">

        <div class="ts-login-brand">

            <div class="ts-login-kicker">
                Acceso al sistema
            </div>

            <h1 class="ts-login-title">
                TEMPEST <span>SUSHI</span>
            </h1>

            <div class="ts-accent-line"></div>

            <p class="ts-login-subtitle">
                Inicia sesión para continuar.
            </p>

        </div>

        <div class="ts-login-card">

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="ts-summary">
                </div>

                <div class="ts-form-group">

                    <label asp-for="Correo"
                           class="ts-label">
                    </label>

                    <input asp-for="Correo"
                           class="ts-input"
                           autocomplete="email"
                           placeholder="correo@ejemplo.com" />

                    <span asp-validation-for="Correo"
                          class="ts-validation">
                    </span>

                </div>

                <div class="ts-form-group">

                    <label asp-for="Password"
                           class="ts-label">
                    </label>

                    <input asp-for="Password"
                           class="ts-input"
                           autocomplete="current-password"
                           placeholder="Ingrese su contraseña" />

                    <span asp-validation-for="Password"
                          class="ts-validation">
                    </span>

                </div>

                <div class="ts-check-row">

                    <input asp-for="Recordarme"
                           class="form-check-input" />

                    <label asp-for="Recordarme"
                           class="ts-check-label">
                    </label>

                </div>

                <button type="submit"
                        class="ts-login-button">
                    Iniciar sesión
                </button>

            </form>

        </div>

        <div class="ts-login-footer">
            TempestSushi · Cocina de tormenta, precisión de mar
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        if (typeof anime !== 'undefined') {

            anime({
                targets: '.ts-login-brand',
                opacity: [0, 1],
                translateY: [-15, 0],
                duration: 650,
                easing: 'easeOutQuad'
            });

            anime({
                targets: '.ts-login-card',
                opacity: [0, 1],
                translateY: [22, 0],
                scale: [0.98, 1],
                delay: 180,
                duration: 700,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.ts-login-footer',
                opacity: [0, 1],
                delay: 600,
                duration: 500,
                easing: 'linear'
            });
        }
    </script>
}