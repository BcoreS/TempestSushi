@model TempestSushi.Application.DTOs.RegistroClienteDTO

@{
    ViewData["Title"] = "Crear cuenta";
}

<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0a1128;
        --abyss: #0d1b3e;
        --foam: #e8edf5;
        --vermillion: #c41e3a;
        --gold: #d4af37;
    }

    .ts-register-page {
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        width: 100vw;
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1.5rem;
        background: radial-gradient( ellipse at 50% 0%, rgba(196, 30, 58, 0.18), transparent 55% ), linear-gradient( 180deg, var(--ink) 0%, var(--abyss) 65%, #142454 100% );
    }

    .ts-register-wrapper {
        width: 100%;
        max-width: 680px;
    }

    .ts-register-brand {
        text-align: center;
        margin-bottom: 2rem;
    }

    .ts-register-kicker {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: var(--vermillion);
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 0.65rem;
    }

    .ts-register-title {
        font-family: 'Bodoni Moda', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 1;
        color: var(--foam);
        margin: 0;
    }

        .ts-register-title span {
            color: var(--gold);
            font-style: italic;
        }

    .ts-register-subtitle {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.65);
        margin-top: 0.8rem;
        font-size: 0.95rem;
    }

    .ts-accent-line {
        width: 65px;
        height: 2px;
        background: var(--vermillion);
        margin: 1rem auto 0;
        border-radius: 10px;
    }

    .ts-register-card {
        background: rgba(255, 255, 255, 0.055);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.32);
    }

    .ts-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0 1.25rem;
    }

    .ts-form-group {
        margin-bottom: 1.35rem;
    }

    .ts-form-group-full {
        grid-column: 1 / -1;
    }

    .ts-label {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--foam);
        margin-bottom: 0.5rem;
        display: block;
    }

    .ts-input {
        width: 100%;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.13);
        background: rgba(255, 255, 255, 0.065);
        color: var(--foam);
        padding: 0.85rem 1rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        outline: none;
        transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

        .ts-input::placeholder {
            color: rgba(232, 237, 245, 0.35);
        }

        .ts-input:focus {
            border-color: var(--gold);
            background: rgba(255, 255, 255, 0.085);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.10);
        }

    .ts-validation {
        display: block;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.8rem;
        margin-top: 0.4rem;
        color: #ff8c9f;
    }

    .ts-summary {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.85rem;
        color: #ff9aaa;
        background: rgba(196, 30, 58, 0.10);
        border: 1px solid rgba(196, 30, 58, 0.25);
        border-radius: 10px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.3rem;
    }

        .ts-summary:empty {
            display: none;
        }

    .ts-password-note {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.48);
        font-size: 0.76rem;
        margin-top: 0.4rem;
    }

    .ts-register-button {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 0.9rem 1.5rem;
        background: var(--vermillion);
        color: var(--foam);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-weight: 700;
        letter-spacing: 0.04em;
        box-shadow: 0 10px 28px rgba(196, 30, 58, 0.35);
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

        .ts-register-button:hover {
            transform: translateY(-2px);
            background: #d52443;
            box-shadow: 0 14px 34px rgba(196, 30, 58, 0.45);
        }

    .ts-login-link {
        text-align: center;
        margin-top: 1.25rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.62);
        font-size: 0.88rem;
    }

        .ts-login-link a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 700;
            transition: color 0.2s ease;
        }

            .ts-login-link a:hover {
                color: #f0cf5f;
            }

    .ts-register-footer {
        text-align: center;
        margin-top: 1.4rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        color: rgba(232, 237, 245, 0.42);
        font-size: 0.78rem;
    }

    @@media (max-width: 700px) {
        .ts-register-page {
            padding: 2.5rem 1rem;
        }

        .ts-register-card {
            padding: 1.5rem;
        }

        .ts-form-grid {
            grid-template-columns: 1fr;
        }

        .ts-form-group-full {
            grid-column: auto;
        }
    }
</style>

<section class="ts-register-page">

    <div class="ts-register-wrapper">

        <div class="ts-register-brand">

            <div class="ts-register-kicker">
                Registro de cliente
            </div>

            <h1 class="ts-register-title">
                TEMPEST <span>SUSHI</span>
            </h1>

            <div class="ts-accent-line"></div>

            <p class="ts-register-subtitle">
                Crea tu cuenta para realizar y consultar tus pedidos.
            </p>

        </div>

        <div class="ts-register-card">

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="ts-summary">
                </div>

                <div class="ts-form-grid">

                    <div class="ts-form-group">

                        <label asp-for="Nombre"
                               class="ts-label">
                        </label>

                        <input asp-for="Nombre"
                               class="ts-input"
                               autocomplete="given-name"
                               placeholder="Nombre" />

                        <span asp-validation-for="Nombre"
                              class="ts-validation">
                        </span>

                    </div>

                    <div class="ts-form-group">

                        <label asp-for="Apellidos"
                               class="ts-label">
                        </label>

                        <input asp-for="Apellidos"
                               class="ts-input"
                               autocomplete="family-name"
                               placeholder="Apellidos" />

                        <span asp-validation-for="Apellidos"
                              class="ts-validation">
                        </span>

                    </div>

                    <div class="ts-form-group ts-form-group-full">

                        <label asp-for="Correo"
                               class="ts-label">
                        </label>

                        <input asp-for="Correo"
                               class="ts-input"
                               autocomplete="email"
                               placeholder="correo@ejemplo.com" />

                        <span asp-validation-for="Correo"
                              class="ts-validation">
                        </span>

                    </div>

                    <div class="ts-form-group ts-form-group-full">

                        <label asp-for="Telefono"
                               class="ts-label">
                        </label>

                        <input asp-for="Telefono"
                               class="ts-input"
                               autocomplete="tel"
                               placeholder="Número de teléfono" />

                        <span asp-validation-for="Telefono"
                              class="ts-validation">
                        </span>

                    </div>

                    <div class="ts-form-group">

                        <label asp-for="Password"
                               class="ts-label">
                        </label>

                        <input asp-for="Password"
                               class="ts-input"
                               autocomplete="new-password"
                               placeholder="Contraseña" />

                        <span asp-validation-for="Password"
                              class="ts-validation">
                        </span>

                        <div class="ts-password-note">
                            Mínimo 8 caracteres.
                        </div>

                    </div>

                    <div class="ts-form-group">

                        <label asp-for="ConfirmarPassword"
                               class="ts-label">
                        </label>

                        <input asp-for="ConfirmarPassword"
                               class="ts-input"
                               autocomplete="new-password"
                               placeholder="Confirme la contraseña" />

                        <span asp-validation-for="ConfirmarPassword"
                              class="ts-validation">
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="ts-register-button">
                    Crear cuenta
                </button>

            </form>

            <div class="ts-login-link">
                ¿Ya tienes una cuenta?
                <a asp-controller="Account"
                   asp-action="Login">
                    Iniciar sesión
                </a>
            </div>

        </div>

        <div class="ts-register-footer">
            TempestSushi · Cocina de tormenta, precisión de mar
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        if (typeof anime !== 'undefined') {

            anime({
                targets: '.ts-register-brand',
                opacity: [0, 1],
                translateY: [-15, 0],
                duration: 650,
                easing: 'easeOutQuad'
            });

            anime({
                targets: '.ts-register-card',
                opacity: [0, 1],
                translateY: [22, 0],
                scale: [0.98, 1],
                delay: 180,
                duration: 700,
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.ts-register-footer',
                opacity: [0, 1],
                delay: 600,
                duration: 500,
                easing: 'linear'
            });
        }
    </script>
}