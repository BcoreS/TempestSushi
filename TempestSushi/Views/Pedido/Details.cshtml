@model TempestSushi.Application.DTOs.PedidoDTO
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Detalle de Pedido";

    var culturaCR =
        new System.Globalization.CultureInfo("es-CR");

    var tokens =
        Antiforgery.GetAndStoreTokens(Context);

    bool esEmpleado =
        (bool)ViewBag.EsEmpleado;
}

<meta name="csrf-token"
      content="@tokens.RequestToken" />

<style>
    :root {
        --tsd-azul-oscuro: #1a3a6e;
        --tsd-azul-medio: #294869;
        --tsd-azul-claro: #4fa8e8;
        --tsd-azul-borde: #d0e8f8;
        --tsd-azul-fondo: #f0f6fc;
        --tsd-rojo: #c0392b;
        --tsd-rojo-hover: #a5301f;
        --tsd-verde: #1a7d3a;
        --tsd-gris-vacio: #8ab2cc;
    }

    .pedido-detail-page {
        width: 100%;
        max-width: 950px;
        margin: 0 auto;
        padding: 1rem 0 2rem;
    }

    /* ═══════════════════════════════════════
               FACTURA
               ═══════════════════════════════════════ */

    .ts-factura {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        overflow: hidden;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(26, 58, 110, 0.10);
        opacity: 0;
    }

    /* ═══════════════════════════════════════
               HEADER (con blobs ambientales, igual que el carrito)
               ═══════════════════════════════════════ */

    .ts-factura-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #1a3a6e 55%, #142f58);
        color: #ffffff;
    }

    .ts-header-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(38px);
        pointer-events: none;
    }

    .ts-header-blob--1 {
        width: 220px;
        height: 220px;
        background: var(--tsd-azul-claro);
        opacity: .25;
        top: -110px;
        right: -60px;
    }

    .ts-header-blob--2 {
        width: 160px;
        height: 160px;
        background: #ffffff;
        opacity: .08;
        bottom: -90px;
        left: 20%;
    }

    .ts-factura-header-texto {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .ts-factura-titulo {
        margin: 0;
        font-family: 'Rajdhani', sans-serif;
        font-size: clamp( 1.3rem, 4vw, 1.5rem );
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 1px;
    }

    .ts-factura-numero {
        display: inline-block;
        margin-top: 2px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.95rem;
        opacity: 0.85;
        white-space: nowrap;
    }

    /* Sello circular animado con anillo + check/X, como en el carrito */
    .ts-header-sello {
        position: relative;
        z-index: 1;
        width: 84px;
        height: 84px;
        flex-shrink: 0;
        display: none;
    }

    @@media (min-width: 560px) {
        .ts-header-sello {
            display: block;
        }
    }

    .ts-sello-dash {
        stroke: rgba(255,255,255,0.35);
        transform-origin: 42px 42px;
    }

    .ts-sello-draw {
        stroke: var(--tsd-azul-claro);
        transform-origin: 42px 42px;
    }

    /* ═══════════════════════════════════════
               BODY
               ═══════════════════════════════════════ */

    .ts-factura-body {
        padding: 2rem;
    }

    /* ═══════════════════════════════════════
               DATOS GENERALES
               ═══════════════════════════════════════ */

    .ts-encabezado-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem 2rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px dashed #d0e8f8;
    }

        .ts-encabezado-grid > div {
            min-width: 0;
            opacity: 0;
        }

    .ts-campo-label {
        margin-bottom: 2px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        color: #4fa8e8;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ts-campo-valor {
        min-width: 0;
        color: #1a3a6e;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .ts-campo-secundario {
        margin-top: 2px;
        color: #8ab2cc;
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    /* ═══════════════════════════════════════
               ESTADO
               ═══════════════════════════════════════ */

    .ts-estado-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        max-width: 100%;
        padding: 4px 14px;
        border-radius: 999px;
        background: #4fa8e8;
        color: #ffffff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        overflow-wrap: anywhere;
        overflow: hidden;
    }

        .ts-estado-badge::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle, rgba(255,255,255,.55) 0%, rgba(255,255,255,0) 70%);
            opacity: 0;
            transform: scale(0);
            pointer-events: none;
        }

    .ts-cambiar-estado {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 0.65rem;
    }

    .ts-select-estado {
        min-height: 39px;
        max-width: 220px;
        padding: 0.35rem 0.6rem;
        border: 1px solid #c7dcf0;
        border-radius: 8px;
        background: #ffffff;
        color: #1a3a6e;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        transition: box-shadow .2s ease, border-color .2s ease;
    }

        .ts-select-estado:focus {
            outline: none;
            border-color: var(--tsd-azul-claro);
            box-shadow: 0 0 0 3px rgba(79, 168, 232, .18);
        }

    .ts-btn-estado {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 1rem;
        border: none;
        border-radius: 999px;
        background: #1a3a6e;
        color: #ffffff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
    }

        .ts-btn-estado:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    /* ═══════════════════════════════════════
               CLIMA
               ═══════════════════════════════════════ */

    .ts-clima-franja {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: -1rem 0 2rem 0;
        padding: 0.75rem 1rem;
        border: 1px solid #d0e8f8;
        border-radius: 10px;
        background: #f0f6fc;
        opacity: 0;
    }

    .ts-clima-icono {
        flex-shrink: 0;
        font-size: 1.6rem;
        display: inline-block;
    }

    .ts-clima-info {
        min-width: 0;
    }

        .ts-clima-info .ts-campo-label {
            margin-bottom: 0;
        }

    /* ═══════════════════════════════════════
               TABLA
               ═══════════════════════════════════════ */

    .ts-tabla-wrapper {
        width: 100%;
        margin-bottom: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
    }

    .ts-tabla-detalle {
        width: 100%;
        min-width: 760px;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .ts-tabla-detalle thead th {
            padding: 0.6rem 0.75rem;
            border-bottom: 2px solid #1a3a6e;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            color: #1a3a6e;
            letter-spacing: 0.05em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .ts-tabla-detalle tbody tr {
            opacity: 0;
        }

        .ts-tabla-detalle tbody td {
            padding: 0.7rem 0.75rem;
            border-bottom: 1px solid #eef4fa;
            color: #294869;
            font-size: 0.92rem;
            vertical-align: middle;
        }

        .ts-tabla-detalle tbody tr:hover {
            background: var(--tsd-azul-fondo);
        }

        .ts-tabla-detalle .ts-col-num {
            text-align: right;
            white-space: nowrap;
        }

    .ts-tipo-tag {
        margin-top: 2px;
        color: #8ab2cc;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    /* ═══════════════════════════════════════
               TOTALES
               ═══════════════════════════════════════ */

    .ts-totales {
        width: 100%;
        max-width: 320px;
        margin-left: auto;
        opacity: 0;
    }

    .ts-totales-fila {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.4rem 0;
        color: #294869;
        font-size: 0.95rem;
    }

        .ts-totales-fila span:last-child {
            flex-shrink: 0;
            white-space: nowrap;
            font-weight: 600;
        }

        .ts-totales-fila.ts-envio {
            color: #8ab2cc;
        }

        .ts-totales-fila.ts-total-final {
            margin-top: 0.5rem;
            padding-top: 0.75rem;
            border-top: 2px solid #1a3a6e;
            color: #1a3a6e;
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
        }

    /* ═══════════════════════════════════════
               VOLVER
               ═══════════════════════════════════════ */

    .ts-volver {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 1.5rem;
        padding: 0.55rem 1rem;
        border: 1.5px solid transparent;
        border-radius: 8px;
        color: #1a3a6e;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        text-decoration: none;
        opacity: 0;
    }

        .ts-volver:hover {
            border-color: #d0e8f8;
            background: #f5faff;
            color: #c0392b;
        }

    /* ═══════════════════════════════════════
               TOAST
               ═══════════════════════════════════════ */

    .ts-toast-detalle {
        position: fixed;
        right: 24px;
        bottom: 24px;
        width: calc(100% - 48px);
        min-width: 0;
        max-width: 360px;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        color: #ffffff;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        line-height: 1.4;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
        z-index: 2000;
        opacity: 0;
        pointer-events: none;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .ts-toast-detalle.ts-exito {
            background: #1a7d3a;
        }

        .ts-toast-detalle.ts-error {
            background: #c0392b;
        }

    #tsdConfetti {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 2500;
        overflow: hidden;
    }

    .tsd-confetti-pieza {
        position: absolute;
        width: 7px;
        height: 7px;
        border-radius: 2px;
        top: 45%;
        left: 50%;
    }

    /* ═══════════════════════════════════════
               TABLET
               ═══════════════════════════════════════ */

    @@media (max-width: 768px) {

        .pedido-detail-page {
            padding: 0.75rem 0 1.5rem;
        }

        .ts-factura-header {
            padding: 1.25rem 1.5rem;
        }

        .ts-factura-body {
            padding: 1.5rem;
        }

        .ts-encabezado-grid {
            gap: 1rem 1.25rem;
        }
    }

    /* ═══════════════════════════════════════
               MÓVIL
               ═══════════════════════════════════════ */

    @@media (max-width: 576px) {

        .pedido-detail-page {
            padding-top: 0.5rem;
        }

        .ts-factura {
            border-radius: 12px;
        }

        .ts-factura-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.3rem;
            padding: 1.1rem 1.2rem;
        }

        .ts-header-sello {
            display: none;
        }

        .ts-factura-titulo {
            font-size: 1.3rem;
        }

        .ts-factura-numero {
            font-size: 0.85rem;
        }

        .ts-factura-body {
            padding: 1.25rem 1rem;
        }

        .ts-encabezado-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1.25rem;
        }

        .ts-campo-valor {
            font-size: 0.95rem;
        }

        .ts-cambiar-estado {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

        .ts-select-estado {
            width: 100%;
            max-width: none;
            min-height: 43px;
        }

        .ts-btn-estado {
            width: 100%;
            min-height: 43px;
            border-radius: 8px;
        }

        .ts-clima-franja {
            align-items: flex-start;
            margin: -0.5rem 0 1.5rem 0;
            padding: 0.8rem 0.9rem;
        }

        .ts-tabla-detalle {
            min-width: 730px;
        }

        .ts-totales {
            max-width: 100%;
            margin-left: 0;
        }

        .ts-volver {
            width: 100%;
            min-height: 45px;
            border-color: #d0e8f8;
        }

        .ts-toast-detalle {
            right: 12px;
            bottom: 12px;
            width: calc(100% - 24px);
            max-width: none;
            padding: 0.9rem 1rem;
        }
    }

    /* ═══════════════════════════════════════
               TELÉFONO PEQUEÑO
               ═══════════════════════════════════════ */

    @@media (max-width: 390px) {

        .ts-factura-header {
            padding: 1rem 0.95rem;
        }

        .ts-factura-body {
            padding: 1.1rem 0.85rem;
        }

        .ts-factura-titulo {
            font-size: 1.2rem;
        }

        .ts-campo-label {
            font-size: 0.7rem;
        }

        .ts-clima-icono {
            font-size: 1.4rem;
        }

        .ts-totales-fila {
            font-size: 0.88rem;
        }

            .ts-totales-fila.ts-total-final {
                font-size: 1.12rem;
            }
    }

    /* ═══════════════════════════════════════
               MOVIMIENTO REDUCIDO
               ═══════════════════════════════════════ */

    @@media (prefers-reduced-motion: reduce) {

        .ts-factura,
        .ts-encabezado-grid > div,
        .ts-clima-franja,
        .ts-tabla-detalle tbody tr,
        .ts-totales,
        .ts-volver {
            opacity: 1 !important;
        }
    }
</style>

<div class="pedido-detail-page">

    <div class="ts-factura" id="tsFactura">

        <!-- HEADER -->

        <div class="ts-factura-header">

            <div class="ts-header-blob ts-header-blob--1"></div>
            <div class="ts-header-blob ts-header-blob--2"></div>

            <div class="ts-factura-header-texto">

                <h2 class="ts-factura-titulo">
                    Detalle de Pedido
                </h2>

                <span class="ts-factura-numero">
                    Pedido N.º @Model.IdPedido
                </span>

            </div>

            <div class="ts-header-sello" aria-hidden="true">
                <svg viewBox="0 0 84 84" width="84" height="84">
                    <circle class="ts-sello-dash" cx="42" cy="42" r="36" fill="none" stroke-width="1.5" stroke-dasharray="4 5" />
                    <circle class="ts-sello-draw" cx="42" cy="42" r="28" fill="none" stroke-width="3" stroke-linecap="round"
                            pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
                    <path class="ts-sello-check"
                          d="M30 43 L38 51 L55 32"
                          fill="none" stroke="#ffffff"
                          stroke-width="5" stroke-linecap="round" stroke-linejoin="round"
                          pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" />
                </svg>
            </div>

        </div>

        <div class="ts-factura-body">

            <!-- ═══════════════════════════
                 INFORMACIÓN GENERAL
                 ═══════════════════════════ -->

            <div class="ts-encabezado-grid">

                <!-- FECHA -->

                <div>

                    <div class="ts-campo-label">
                        Fecha
                    </div>

                    <div class="ts-campo-valor">

                        @Model.FechaPedido.ToString(
                        "dd/MM/yyyy HH:mm",
                                                culturaCR
                                                )

                    </div>

                </div>

                <!-- ESTADO -->

                <div>

                    <div class="ts-campo-label">
                        Estado
                    </div>

                    <div class="ts-campo-valor">

                        <span class="ts-estado-badge"
                              id="estadoBadgeActual">

                            @Model.EstadoNombre

                        </span>

                    </div>

                    @if (esEmpleado)
                                        {
                    <div class="ts-cambiar-estado">

                        <select id="selectEstado"
                                class="ts-select-estado">

                            @foreach (
                                                        var estado in
                                                        (List<TempestSushi.Application.DTOs.PedidoMetodoOpcionDto>)
                                                        ViewBag.Estados
                                                        )
                                                        {
                            <option value="@estado.Id"
                                    selected="@(estado.Nombre == Model.EstadoNombre)">

                                @estado.Nombre

                            </option>
                                                        }

                        </select>

                        <button type="button"
                                id="btnActualizarEstado"
                                class="ts-btn-estado">

                            Actualizar

                        </button>

                    </div>
                                        }

                </div>

                <!-- CLIENTE -->

                <div>

                    <div class="ts-campo-label">
                        Cliente
                    </div>

                    <div class="ts-campo-valor">
                        @Model.ClienteNombre
                    </div>

                    <div class="ts-campo-secundario">
                        @Model.ClienteIdentificador
                    </div>

                </div>

                <!-- ENCARGADO -->

                <div>

                    <div class="ts-campo-label">
                        Encargado
                    </div>

                    <div class="ts-campo-valor">
                        @(Model.EncargadoNombre ?? "—")
                    </div>

                </div>

                <!-- MÉTODO DE ENTREGA -->

                <div>

                    <div class="ts-campo-label">
                        Método de entrega
                    </div>

                    <div class="ts-campo-valor">

                        @Model.MetodoEntregaNombre

                        @if (
                                                !string.IsNullOrWhiteSpace(
                                                Model.DireccionEntrega
                                                )
                                                )
                        {
                            <div class="ts-campo-secundario">
                                @Model.DireccionEntrega
                            </div>
                        }

                    </div>

                </div>

                <!-- MÉTODO DE PAGO -->

                <div>

                    <div class="ts-campo-label">
                        Método de pago
                    </div>

                    <div class="ts-campo-valor">
                        @Model.MetodoPagoNombre
                    </div>

                </div>

            </div>

            <!-- ═══════════════════════════
                 CLIMA
                 ═══════════════════════════ -->
            @if (
                        Model.MetodoEntregaNombre.Contains(
                        "domicilio",
                        StringComparison.OrdinalIgnoreCase
                        )
                        &&
                        ViewBag.Clima != null
                        )
            {
                <div class="ts-clima-franja" id="tsClimaFranja">

                    <span class="ts-clima-icono"
                          aria-hidden="true"
                          id="tsClimaIcono">

                        🌤️

                    </span>

                    <div class="ts-clima-info">

                        <div class="ts-campo-label">
                            Clima actual para la entrega
                        </div>

                        <div class="ts-campo-valor">

                            @(
                                                    ((TempestSushi.Application.DTOs.ClimaDto)
                                                    ViewBag.Clima).Temperatura
                                                    )°C
                            —
                            @(
                                                    ((TempestSushi.Application.DTOs.ClimaDto)
                                                    ViewBag.Clima).Descripcion
                                                    )

                    </div>

                    </div>

                </div>
                        }

            <!-- ═══════════════════════════
                 DETALLE
                 ═══════════════════════════ -->

            <div class="ts-tabla-wrapper">

                <table class="ts-tabla-detalle">

                    <thead>

                        <tr>

                            <th>
                                Producto / Combo
                            </th>

                            <th class="ts-col-num">
                                Precio
                            </th>

                            <th class="ts-col-num">
                                Cantidad
                            </th>

                            <th class="ts-col-num">
                                Subtotal
                            </th>

                            <th class="ts-col-num">
                                Impuesto
                            </th>

                            <th>
                                Observaciones
                            </th>

                        </tr>

                    </thead>

                    <tbody id="tsTablaBody">

                        @foreach (var linea in Model.Lineas)
                        {
                            <tr>

                                <td>

                                    @linea.Nombre

                                    <div class="ts-tipo-tag">
                                        @linea.Tipo
                                    </div>

                                </td>

                                <td class="ts-col-num">

                                    @linea.PrecioUnitario.ToString(
                                    "C",
                                                                culturaCR
                                                                )

                            </td>

                            <td class="ts-col-num">
                                @linea.Cantidad
                            </td>

                            <td class="ts-col-num ts-subtotal-linea">

                                @linea.Subtotal.ToString(
                                                                "C",
                                                                culturaCR
                                                                )

                            </td>

                            <td class="ts-col-num">

                                @linea.Impuesto.ToString(
                                                                "C",
                                                                culturaCR
                                                                )

                            </td>

                            <td>

                                @(
                                                                string.IsNullOrWhiteSpace(
                                                                linea.Observaciones
                                                                )
                                                                ? "—"
                                                                : linea.Observaciones
                                                                )

                            </td>

                            </tr>
                                                }

                    </tbody>

                </table>

            </div>

            <!-- ═══════════════════════════
                 TOTALES
                 ═══════════════════════════ -->

            <div class="ts-totales" id="tsTotales">

                <div class="ts-totales-fila">

                    <span>
                        Total sin impuestos
                    </span>

                    <span id="tsValorSinImpuestos"
                          data-valor="@Model.TotalSinImpuestos.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                        @Model.TotalSinImpuestos.ToString(
                        "C",
                                                culturaCR
                                                )

                    </span>

                </div>

                @if (Model.CostoEnvio > 0)
                                {
                <div class="ts-totales-fila ts-envio">

                    <span>
                        Costo de envío
                    </span>

                    <span>

                        @Model.CostoEnvio.ToString(
                                                "C",
                                                culturaCR
                                                )

                    </span>

                </div>
                                }

                <div class="ts-totales-fila ts-total-final">

                    <span>
                        Total con impuestos
                    </span>

                    <span id="tsValorConImpuestos"
                          data-valor="@Model.TotalConImpuestos.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                        @Model.TotalConImpuestos.ToString(
                                                "C",
                                                culturaCR
                                                )

                    </span>

                </div>

            </div>

            <!-- VOLVER -->

            <a asp-action="Index"
               class="ts-volver"
               id="tsVolverLink">

                &larr; Volver al historial

            </a>

        </div>

    </div>

</div>

<div id="toastDetalle"
     class="ts-toast-detalle">
</div>
<div id="tsdConfetti"></div>

@section Scripts {

<script type="module">
    import { animate, stagger, createSpring, createTimeline, utils } from 'https://cdn.jsdelivr.net/npm/animejs@4.0.2/+esm';

    try {

    const culturaFormatoMoneda = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', minimumFractionDigits: 2 });

    const ICONO_EXITO = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>';
    const ICONO_ERROR = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2"><path d="M12 3l10 18H2z"/><path d="M12 9v5M12 17h.01"/></svg>';

    function formatoMoneda(valor) {
        return culturaFormatoMoneda.format(valor || 0);
    }

    function animarNumeroEnElemento(el, hasta) {
        const desde = parseFloat(el.dataset.valor || 0);
        const obj = { valor: desde };
        animate(obj, {
            valor: hasta,
            duration: 700,
            ease: 'outExpo',
            onUpdate: () => { el.textContent = formatoMoneda(obj.valor); }
        });
        el.dataset.valor = hasta;
    }

    // ── Entrada orquestada de toda la factura, igual filosofía que el carrito ──
    // IMPORTANTE: ninguna animación con loop:true va dentro del timeline —
    // una animación infinita encadenada hace que el timeline nunca "termine"
    // ese paso, y todo lo agregado después queda esperando para siempre.
    createTimeline()
        .add('#tsFactura', { opacity: [0, 1], translateY: [-14, 0], duration: 500, ease: 'outQuad' })
        .add('.ts-header-blob--1', { opacity: [0, .25], scale: [0.6, 1], duration: 700, ease: 'outQuad' }, '-=250')
        .add('.ts-header-blob--2', { opacity: [0, .08], scale: [0.6, 1], duration: 700, ease: 'outQuad' }, '<')
        .add('.ts-sello-draw', { strokeDashoffset: [100, 0], duration: 900, ease: 'outExpo' }, '-=400')
        .add('.ts-sello-check', { strokeDashoffset: [1, 0], duration: 450, ease: 'outQuad' }, '-=150')
        .add('.ts-encabezado-grid > div', { opacity: [0, 1], translateY: [14, 0], duration: 450, delay: stagger(70), ease: 'outQuad' }, '-=200')
        .add('#tsClimaFranja', { opacity: [0, 1], translateX: [-16, 0], duration: 450, ease: 'outQuad' }, '-=250')
        .add('#tsTablaBody tr', { opacity: [0, 1], translateX: [-18, 0], duration: 400, delay: stagger(70), ease: 'outExpo' }, '-=150')
        .add('#tsTotales', {
            opacity: [0, 1],
            translateY: [10, 0],
            duration: 450,
            ease: 'outQuad',
            onBegin: iniciarConteoTotales
        }, '-=150')
        .add('#tsVolverLink', { opacity: [0, 1], translateY: [8, 0], duration: 400, ease: 'outQuad' }, '-=200');

    // Animaciones infinitas (loop:true) SIEMPRE fuera del timeline, como llamadas
    // independientes a animate() — igual que los blobs del carrito.
    animate('.ts-header-blob--1', { translateY: [0, -14, 0], translateX: [0, 12, 0], duration: 7200, loop: true, ease: 'inOutSine', delay: 1200 });
    animate('.ts-header-blob--2', { translateY: [0, 10, 0], translateX: [0, -10, 0], duration: 6400, loop: true, ease: 'inOutSine', delay: 1200 });
    animate('.ts-sello-dash', { rotate: 360, duration: 20000, loop: true, ease: 'linear' });

    // El ícono del clima "flota" suavemente
    const climaIcono = document.getElementById('tsClimaIcono');
    if (climaIcono) {
        animate(climaIcono, { translateY: [0, -4, 0], duration: 2400, loop: true, ease: 'inOutSine', delay: 1400 });
    }

    // Micro-interacción al pasar el mouse por cada fila de la tabla (desktop)
    document.querySelectorAll('#tsTablaBody tr').forEach(fila => {
        fila.addEventListener('mouseenter', () => {
            animate(fila, { translateX: 4, duration: 200, ease: 'outQuad' });
        });
        fila.addEventListener('mouseleave', () => {
            animate(fila, { translateX: 0, duration: 200, ease: 'outQuad' });
        });
    });

    // Los totales "cuentan" desde cero hasta el valor final, exactamente en el
    // instante en que el bloque de totales empieza a hacerse visible (onBegin
    // del paso del timeline) — así el conteo se ve mientras el bloque aparece,
    // en vez de terminar antes de que el usuario lo vea.
    let conteoTotalesYaIniciado = false;

    function iniciarConteoTotales() {
        if (conteoTotalesYaIniciado) return;
        conteoTotalesYaIniciado = true;

        const elSinImp = document.getElementById('tsValorSinImpuestos');
        const elConImp = document.getElementById('tsValorConImpuestos');
        const totalSinImp = parseFloat(elSinImp.dataset.valor);
        const totalConImp = parseFloat(elConImp.dataset.valor);
        elSinImp.dataset.valor = 0;
        elConImp.dataset.valor = 0;
        elSinImp.textContent = formatoMoneda(0);
        elConImp.textContent = formatoMoneda(0);
        animarNumeroEnElemento(elSinImp, totalSinImp);
        animarNumeroEnElemento(elConImp, totalConImp);
    }

    // ── Cambio de estado (empleados) ────────────────────────────────
    const btnActualizar = document.getElementById('btnActualizarEstado');

    if (btnActualizar) {

        const toast = document.getElementById('toastDetalle');
        const confettiLayer = document.getElementById('tsdConfetti');
        const badgeEstado = document.getElementById('estadoBadgeActual');

        const idPedido = @Model.IdPedido;

        const csrfToken =
            document
                .querySelector('meta[name="csrf-token"]')
                .content;

        function mostrarToastDetalle(mensaje, tipo) {

            const icono = tipo === 'error' ? ICONO_ERROR : ICONO_EXITO;
            toast.innerHTML = `${icono}<span>${mensaje}</span>`;
            toast.className = 'ts-toast-detalle ' + (tipo === 'error' ? 'ts-error' : 'ts-exito');

            clearTimeout(toast._timeoutId);

            animate(toast, {
                opacity: [0, 1],
                translateY: [24, 0],
                scale: [0.95, 1],
                duration: 450,
                ease: createSpring({ stiffness: 210, damping: 15 })
            });

            toast._timeoutId = setTimeout(() => {
                animate(toast, { opacity: 0, translateY: 16, duration: 350, ease: 'inQuad' });
            }, 3800);
        }

        function lanzarConfetiEstado() {
            const colores = ['#1a3a6e', '#4fa8e8', '#c0392b', '#1a7d3a', '#d0e8f8'];
            const piezas = [];
            const rectBadge = badgeEstado.getBoundingClientRect();
            for (let i = 0; i < 26; i++) {
                const pieza = document.createElement('div');
                pieza.className = 'tsd-confetti-pieza';
                pieza.style.background = colores[i % colores.length];
                pieza.style.left = rectBadge.left + rectBadge.width / 2 + 'px';
                pieza.style.top = rectBadge.top + 'px';
                confettiLayer.appendChild(pieza);
                piezas.push(pieza);
            }
            animate(piezas, {
                x: () => utils.random(-140, 140),
                y: () => utils.random(-40, 180),
                rotate: () => utils.random(-360, 360),
                opacity: [1, 0],
                duration: () => utils.random(700, 1200),
                delay: stagger(5),
                ease: 'outExpo',
                onComplete: (a) => a.targets.forEach(t => t.remove())
            });
        }

        btnActualizar.addEventListener('click', async function () {

            const selectEstado = document.getElementById('selectEstado');
            const idEstado = selectEstado.value;
            const nombreNuevoEstado = selectEstado.selectedOptions[0].textContent.trim();

            btnActualizar.disabled = true;
            const pulso = animate(btnActualizar, { scale: [1, 0.96, 1], duration: 500, loop: true, ease: 'inOutSine' });

            try {

                const resp = await fetch(
                    '@Url.Action("CambiarEstado", "Pedido")',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': csrfToken
                        },
                        body: JSON.stringify({
                            idPedido: idPedido,
                            idEstadoPedido: parseInt(idEstado, 10)
                        })
                    }
                );

                if (!resp.ok) {
                    const error = await resp.json().catch(() => ({
                        mensaje: 'No se pudo actualizar el estado.'
                    }));
                    throw new Error(error.mensaje || 'No se pudo actualizar el estado.');
                }

                pulso.pause();
                btnActualizar.style.transform = '';

                // Actualiza el badge visualmente antes del recargo, con un pequeño "pop" + confeti
                badgeEstado.textContent = nombreNuevoEstado;
                animate(badgeEstado, {
                    scale: [0.85, 1.15, 1],
                    duration: 550,
                    ease: createSpring({ stiffness: 240, damping: 12 })
                });
                lanzarConfetiEstado();

                mostrarToastDetalle('Estado actualizado correctamente.', 'exito');

                setTimeout(() => location.reload(), 1100);
            }
            catch (e) {
                pulso.pause();
                btnActualizar.style.transform = '';
                animate(btnActualizar, {
                    translateX: [0, -6, 6, -6, 6, 0],
                    duration: 400,
                    ease: 'inOutSine'
                });
                mostrarToastDetalle(e.message, 'error');
                btnActualizar.disabled = false;
            }
        });
    }

    } catch (e) {
        console.error('Error en la animación del detalle de pedido:', e);
        document.querySelectorAll('#tsFactura, .ts-encabezado-grid > div, #tsClimaFranja, #tsTablaBody tr, #tsTotales, #tsVolverLink')
            .forEach(el => { el.style.opacity = '1'; });
    }

    // Red de seguridad: si por cualquier razón (CDN lento/caído, versión distinta, etc.)
    // las animaciones no corrieron a tiempo, nunca dejamos la página en blanco.
    setTimeout(() => {
        document.querySelectorAll('#tsFactura, .ts-encabezado-grid > div, #tsClimaFranja, #tsTablaBody tr, #tsTotales, #tsVolverLink')
            .forEach(el => {
                if (parseFloat(getComputedStyle(el).opacity) < 1) {
                    el.style.opacity = '1';
                }
            });
    }, 3000);
</script>

}
