@model TempestSushi.Application.DTOs.ComboFormDto
@{
    ViewData["Title"] = "Crear Combo";
}

<style>
    .form-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #d0e8f8;
    }

    .form-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.9rem;
        font-weight: 700;
        color: #1a3a6e;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1.5px solid #d0e8f8;
        border-radius: 14px;
        padding: 2rem;
        box-shadow: 0 2px 16px rgba(26,58,110,0.07);
    }

    .form-label {
        font-weight: 600;
        color: #1a3a6e;
    }

    .productos-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border: 1px solid #d0e8f8;
        border-radius: 10px;
        padding: 1rem;
        max-height: 260px;
        overflow-y: auto;
    }

    .producto-chip {
        background: #e8f4fd;
        border-radius: 20px;
        padding: 6px 14px;
        cursor: pointer;
    }

    .btn-guardar {
        background: #1a3a6e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
    }

        .btn-guardar:hover {
            background: #c0392b;
            color: #fff;
        }

    .btn-cancelar {
        border: 1.5px solid #1a3a6e;
        color: #1a3a6e;
        border-radius: 8px;
        padding: 10px 28px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
    }

        .btn-cancelar:hover {
            background: #1a3a6e;
            color: #fff;
        }
</style>

<div class="form-header">
    <h1 class="form-title">Crear Combo</h1>
</div>

<div class="form-card">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Combo Pareja" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">Precio (₡)</label>
            <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Productos incluidos</label>
            <div class="productos-grid">
                @foreach (var prod in Model.ProductosDisponibles)
                {
                    <label class="producto-chip">
                        <input type="checkbox" name="ProductosSeleccionados" value="@prod.IdProducto" />
                        @prod.Nombre (₡@prod.Precio.ToString("N2"))
                    </label>
                }
            </div>
            <span asp-validation-for="ProductosSeleccionados" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-guardar">Guardar combo</button>
            <a asp-action="Index" class="btn-cancelar">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}