<!-- ═══════════════════════════════════════
     ANIMACIONES — anime.js v4.0.2 (ESM)
     ═══════════════════════════════════════ -->

<script type="module">
    import { animate, stagger, createTimeline, createSpring, utils } from 'https://cdn.jsdelivr.net/npm/animejs@4.0.2/+esm';

    const prefersReducedMotion =
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
        document.body.classList.add('ts-static');
    } else {

        try {

            const hero = document.getElementById('tsHero');
            const heroDecor = document.getElementById('tsHeroDecor');

            /* ── Ruta decorativa: se prepara el trazo antes de animar ── */
            const path = document.getElementById('tsPath');
            let pathLength = 0;
            if (path) {
                pathLength = path.getTotalLength();
                path.style.strokeDasharray = pathLength;
                path.style.strokeDashoffset = pathLength;
            }

            /* ── Timeline de entrada: todo lo que ocurre UNA vez, en orden ── */
            const entrada = createTimeline()
                .add('.ts-kicker', {
                    opacity: [0, 1],
                    translateY: [12, 0],
                    duration: 600,
                    ease: 'outQuad'
                })
                .add('#tsHeadline .word', {
                    opacity: [0, 1],
                    translateY: [30, 0],
                    duration: 800,
                    delay: stagger(150),
                    ease: 'outExpo'
                }, '-=300')
                .add('#tsPath', {
                    strokeDashoffset: [pathLength, 0],
                    duration: 1100,
                    ease: 'inOutSine'
                }, '-=350')
                .add('#tsSub', {
                    opacity: [0, 1],
                    translateY: [10, 0],
                    duration: 600,
                    ease: 'outQuad'
                }, '-=650')
                .add('#tsCtas .ts-cta', {
                    opacity: [0, 1],
                    scale: [0.9, 1],
                    duration: 550,
                    delay: stagger(120),
                    ease: createSpring({ stiffness: 220, damping: 14 })
                }, '-=250')
                .add('#tsWordGlow', {
                    opacity: [0, 1],
                    duration: 500,
                    ease: 'outQuad',
                    onComplete: iniciarPulsoGlow
                }, '-=400')
                .add(heroDecor, {
                    // solo dispara el fade-in de blobs y arranca sus loops al final
                    duration: 1,
                    onBegin: iniciarDecoracionAmbiental
                }, '-=900');

            /* ── Halo dorado detrás de "SUSHI": pulso continuo (loop, fuera del timeline) ── */
            function iniciarPulsoGlow() {
                animate('#tsWordGlow', {
                    scale: [1, 1.18, 1],
                    opacity: [0.6, 1, 0.6],
                    duration: 3200,
                    loop: true,
                    ease: 'inOutSine'
                });
            }

            /* ── Blobs ambientales + burbujas: SIEMPRE fuera del timeline ── */
            function iniciarDecoracionAmbiental() {

                // Fade-in inicial de los blobs (una sola vez)
                animate('#tsBlobA', { opacity: [0, 0.22], duration: 1200, ease: 'outQuad' });
                animate('#tsBlobB', { opacity: [0, 0.22], duration: 1200, delay: 150, ease: 'outQuad' });
                animate('#tsBlobC', { opacity: [0, 0.14], duration: 1200, delay: 300, ease: 'outQuad' });

                // Deriva ambiental infinita de cada blob (independiente, en loop)
                animate('#tsBlobA', {
                    translateX: [0, 40, -10, 0],
                    translateY: [0, -30, 15, 0],
                    duration: 14000,
                    loop: true,
                    ease: 'inOutSine'
                });
                animate('#tsBlobB', {
                    translateX: [0, -35, 10, 0],
                    translateY: [0, 25, -20, 0],
                    duration: 16000,
                    loop: true,
                    ease: 'inOutSine'
                });
                animate('#tsBlobC', {
                    translateX: [0, 25, -25, 0],
                    translateY: [0, -20, 20, 0],
                    duration: 12000,
                    loop: true,
                    ease: 'inOutSine'
                });

                crearBurbujas();
            }

            /* ── Burbujas que suben desde el fondo del hero, como corriente marina ── */
            function crearBurbujas() {
                const total = window.innerWidth < 576 ? 8 : 14;

                for (let i = 0; i < total; i++) {
                    const burbuja = document.createElement('div');
                    burbuja.className = 'ts-hero-particle';

                    const tamano = utils.random(3, 9);
                    burbuja.style.width = tamano + 'px';
                    burbuja.style.height = tamano + 'px';
                    burbuja.style.left = utils.random(2, 98) + '%';

                    heroDecor.appendChild(burbuja);

                    animate(burbuja, {
                        translateY: [0, -utils.random(280, 520)],
                        translateX: [0, utils.random(-30, 30)],
                        opacity: [0, 0.5, 0],
                        duration: () => utils.random(5000, 9000),
                        delay: utils.random(0, 4000),
                        loop: true,
                        ease: 'inOutSine'
                    });
                }
            }

            /* ── Parallax sutil: los blobs siguen al cursor dentro del hero ── */
            let parallaxPendiente = false;

            hero.addEventListener('mousemove', function (evento) {
                if (parallaxPendiente) return;
                parallaxPendiente = true;

                requestAnimationFrame(() => {
                    const rect = hero.getBoundingClientRect();
                    const relX = ((evento.clientX - rect.left) / rect.width - 0.5) * 2;
                    const relY = ((evento.clientY - rect.top) / rect.height - 0.5) * 2;

                    animate('#tsBlobA', { translateX: relX * 18, translateY: relY * 12, duration: 900, ease: 'outQuad' });
                    animate('#tsBlobB', { translateX: relX * -14, translateY: relY * -10, duration: 900, ease: 'outQuad' });
                    animate('#tsBlobC', { translateX: relX * 10, translateY: relY * 8, duration: 900, ease: 'outQuad' });

                    parallaxPendiente = false;
                });
            });

            /* ── Botones: pulso táctil al presionar (además del hover normal en CSS) ── */
            document.querySelectorAll('.ts-cta').forEach((boton) => {
                boton.addEventListener('pointerdown', () => {
                    animate(boton, { scale: [1, 0.94], duration: 150, ease: 'outQuad' });
                });
                boton.addEventListener('pointerup', () => {
                    animate(boton, { scale: [0.94, 1], duration: 350, ease: createSpring({ stiffness: 300, damping: 12 }) });
                });
                boton.addEventListener('pointerleave', () => {
                    animate(boton, { scale: 1, duration: 300, ease: 'outQuad' });
                });
            });

            /* ── Tarjetas: entran cuando llegan a la vista, luego un pequeño "lift" en hover ── */
            const cards = Array.from(document.querySelectorAll('#tsCards .ts-card'));

            if ('IntersectionObserver' in window && cards.length) {

                let yaAnimadas = false;

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting && !yaAnimadas) {
                            yaAnimadas = true;

                            animate(cards, {
                                opacity: [0, 1],
                                translateY: [26, 0],
                                duration: 650,
                                delay: stagger(110),
                                ease: 'outExpo'
                            });

                            observer.disconnect();
                        }
                    });
                }, { threshold: 0.2 });

                observer.observe(document.getElementById('tsCards'));

            } else {
                cards.forEach((card) => { card.style.opacity = '1'; });
            }

            cards.forEach((card) => {
                card.addEventListener('mouseenter', () => {
                    animate(card, {
                        translateY: -7,
                        scale: 1.015,
                        duration: 380,
                        ease: createSpring({ stiffness: 240, damping: 18 })
                    });
                });
                card.addEventListener('mouseleave', () => {
                    animate(card, {
                        translateY: 0,
                        scale: 1,
                        duration: 380,
                        ease: createSpring({ stiffness: 240, damping: 18 })
                    });
                });
            });

        } catch (e) {
            console.error('Error en la animación de la página de inicio:', e);
            document.body.classList.add('ts-static');
        }
    }

    // Red de seguridad: si algo se queda a medio animar (CDN lento, error
    // silencioso, etc.), nunca dejamos contenido invisible.
    setTimeout(() => {
        document.querySelectorAll(
            '.ts-kicker, .ts-headline .word, .ts-sub, .ts-ctas .ts-cta, .ts-cards .ts-card'
        ).forEach((el) => {
            if (parseFloat(getComputedStyle(el).opacity) < 1) {
                el.style.opacity = '1';
            }
        });
    }, 3000);
</script>
