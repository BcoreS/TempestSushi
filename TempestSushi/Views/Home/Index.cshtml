@{
    ViewData["Title"] = "Inicio";
}

<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet">

<style>

    :root {
        --ink: #0a1128;
        --abyss: #0d1b3e;
        --foam: #e8edf5;
        --vermillion: #c41e3a;
        --gold: #d4af37;
        --mist: rgba(255, 255, 255, 0.06);
    }

    /* ═══════════════════════════════════════
               SECCIONES FULL WIDTH
               ═══════════════════════════════════════ */

    .ts-hero,
    .ts-cards-section {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        box-sizing: border-box;
    }

    /* ═══════════════════════════════════════
               HERO
               ═══════════════════════════════════════ */

    .ts-hero {
        position: relative;
        min-height: 86vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 8vh 24px;
        overflow: hidden;
        color: var(--foam);
        background: radial-gradient( ellipse at 50% -10%, rgba(196, 30, 58, 0.20), transparent 55% ), linear-gradient( 180deg, var(--ink) 0%, var(--abyss) 60%, #142454 100% );
    }

        .ts-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient( circle at 15% 75%, rgba(79, 168, 232, 0.05), transparent 28% );
        }

    /* ═══════════════════════════════════════
               DECORACIÓN AMBIENTAL — blobs + burbujas
               (todo lo que se mueve en loop se anima
               SIEMPRE fuera de cualquier timeline)
               ═══════════════════════════════════════ */

    .ts-hero-decor {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .ts-hero-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0;
        will-change: transform;
    }

    .ts-hero-blob--a {
        width: 420px;
        height: 420px;
        top: -160px;
        left: -100px;
        background: var(--vermillion);
    }

    .ts-hero-blob--b {
        width: 340px;
        height: 340px;
        bottom: -140px;
        right: -80px;
        background: var(--gold);
    }

    .ts-hero-blob--c {
        width: 260px;
        height: 260px;
        top: 40%;
        left: 60%;
        background: #4fa8e8;
    }

    .ts-hero-particle {
        position: absolute;
        bottom: -20px;
        border-radius: 50%;
        background: rgba(232, 237, 245, 0.45);
        box-shadow: 0 0 6px rgba(232, 237, 245, 0.35);
        opacity: 0;
        will-change: transform, opacity;
    }

    /* ═══════════════════════════════════════
               KICKER
               ═══════════════════════════════════════ */

    .ts-kicker {
        position: relative;
        z-index: 1;
        margin-bottom: 1.2rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--vermillion);
        opacity: 0;
    }

    /* ═══════════════════════════════════════
               TÍTULO
               ═══════════════════════════════════════ */

    .ts-headline {
        position: relative;
        z-index: 1;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.25em 0.45em;
        font-family: 'Bodoni Moda', serif;
        font-weight: 700;
        font-size: clamp( 3rem, 9vw, 7.5rem );
        line-height: 0.95;
        letter-spacing: 0.01em;
    }

        .ts-headline .word {
            position: relative;
            display: inline-block;
            opacity: 0;
        }

            .ts-headline .word:first-child {
                color: var(--foam);
            }

            .ts-headline .word:last-child {
                color: var(--gold);
                font-style: italic;
            }

    /* Halo dorado detrás de "SUSHI", pulsa suavemente en loop */
    .ts-word-glow {
        position: absolute;
        inset: -18% -12%;
        z-index: -1;
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(212, 175, 55, 0.35), transparent 70%);
        opacity: 0;
        pointer-events: none;
    }

    /* ═══════════════════════════════════════
               LÍNEA DECORATIVA
               ═══════════════════════════════════════ */

    .ts-line-wrap {
        position: relative;
        z-index: 1;
        width: min( 560px, 80vw );
        margin: 1.4rem auto 0;
    }

        .ts-line-wrap svg {
            width: 100%;
            height: auto;
            display: block;
        }

    #tsPath {
        fill: none;
        stroke: var(--vermillion);
        stroke-width: 3;
        stroke-linecap: round;
    }

    /* ═══════════════════════════════════════
               SUBTÍTULO
               ═══════════════════════════════════════ */

    .ts-sub {
        position: relative;
        z-index: 1;
        max-width: 540px;
        margin: 1.6rem auto 0;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: clamp( 1rem, 2vw, 1.25rem );
        line-height: 1.6;
        color: rgba( 232, 237, 245, 0.78 );
        opacity: 0;
    }

    /* ═══════════════════════════════════════
               BOTONES
               ═══════════════════════════════════════ */

    .ts-ctas {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin-top: 2.4rem;
    }

        .ts-ctas .ts-cta {
            opacity: 0;
        }

    .ts-cta {
        min-width: 145px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1.8rem;
        border-radius: 999px;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-decoration: none;
        transition: box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
    }

    .ts-cta-primary {
        background: var(--vermillion);
        color: var(--foam);
        box-shadow: 0 10px 24px rgba(196, 30, 58, 0.35);
    }

        .ts-cta-primary:hover {
            color: var(--foam);
            box-shadow: 0 14px 30px rgba(196, 30, 58, 0.45);
        }

    .ts-cta-secondary {
        border: 1px solid rgba(212, 175, 55, 0.5);
        background: transparent;
        color: var(--gold);
    }

        .ts-cta-secondary:hover {
            border-color: var(--gold);
            background: rgba(212, 175, 55, 0.08);
            color: var(--gold);
        }

    .ts-cta:focus-visible {
        outline: 2px solid rgba(212, 175, 55, 0.80);
        outline-offset: 4px;
    }

    /* ═══════════════════════════════════════
               SECCIÓN CARDS
               ═══════════════════════════════════════ */

    .ts-cards-section {
        padding: 5rem 24px 6rem;
        background: var(--abyss);
    }

    .ts-cards {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat( auto-fit, minmax(230px, 1fr) );
        gap: 1.4rem;
    }

        .ts-cards .ts-card {
            opacity: 0;
        }

    /* ═══════════════════════════════════════
               CARD
               ═══════════════════════════════════════ */

    .ts-card {
        min-width: 0;
        display: block;
        padding: 1.8rem 1.6rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        background: var(--mist);
        color: var(--foam);
        text-decoration: none;
        transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    }

        .ts-card:hover {
            border-color: var(--vermillion);
            background: rgba(196, 30, 58, 0.07);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
        }

        .ts-card:focus-visible {
            outline: 2px solid rgba(212, 175, 55, 0.80);
            outline-offset: 4px;
        }

    .ts-card-eyebrow {
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
    }

    .ts-card h3 {
        margin: 0.5rem 0 0.6rem;
        font-family: 'Bodoni Moda', serif;
        font-size: 1.5rem;
        color: var(--foam);
    }

    .ts-card p {
        margin: 0;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-size: 0.9rem;
        line-height: 1.5;
        color: rgba( 232, 237, 245, 0.70 );
    }

    /* ═══════════════════════════════════════
               FALLBACK SIN ANIME.JS / MOVIMIENTO REDUCIDO
               ═══════════════════════════════════════ */

    body.ts-static .ts-kicker,
    body.ts-static .ts-headline .word,
    body.ts-static .ts-sub,
    body.ts-static .ts-ctas .ts-cta,
    body.ts-static .ts-cards .ts-card {
        opacity: 1;
    }

    body.ts-static #tsPath {
        stroke-dashoffset: 0 !important;
    }

    body.ts-static .ts-hero-decor {
        display: none;
    }

    /* ═══════════════════════════════════════
               TABLET
               ═══════════════════════════════════════ */

    @@media (max-width: 768px) {

        .ts-hero {
            min-height: 78vh;
            padding: 5rem 1.25rem;
        }

        .ts-kicker {
            margin-bottom: 1rem;
            font-size: 0.76rem;
        }

        .ts-headline {
            font-size: clamp( 3rem, 13vw, 5rem );
            gap: 0.2em 0.35em;
        }

        .ts-line-wrap {
            width: min( 500px, 86vw );
            margin-top: 1.2rem;
        }

        .ts-sub {
            max-width: 480px;
            margin-top: 1.35rem;
            font-size: 1rem;
        }

        .ts-ctas {
            margin-top: 2rem;
        }

        .ts-cards-section {
            padding: 4rem 1.25rem 5rem;
        }
    }

    /* ═══════════════════════════════════════
               MÓVIL
               ═══════════════════════════════════════ */

    @@media (max-width: 576px) {

        .ts-hero {
            min-height: 72vh;
            padding: 4rem 1rem;
        }

        .ts-kicker {
            margin-bottom: 0.9rem;
            font-size: 0.72rem;
            letter-spacing: 0.15em;
        }

        .ts-headline {
            font-size: clamp( 2.7rem, 16vw, 4.4rem );
            line-height: 0.98;
            gap: 0.18em 0.32em;
        }

        .ts-line-wrap {
            width: min( 440px, 88vw );
            margin-top: 1.1rem;
        }

        .ts-sub {
            max-width: 360px;
            margin-top: 1.25rem;
            font-size: 0.95rem;
            line-height: 1.55;
        }

        .ts-ctas {
            width: 100%;
            gap: 0.75rem;
            margin-top: 1.8rem;
        }

        .ts-cta {
            width: min( 100%, 300px );
            min-height: 47px;
            padding: 0.8rem 1.4rem;
            text-align: center;
        }

        .ts-cards-section {
            padding: 3rem 1rem 4rem;
        }

        .ts-cards {
            gap: 1rem;
        }

        .ts-card {
            padding: 1.5rem 1.3rem;
        }
        /* Menos partículas/blobs en móvil: se ocultan las extra vía JS */
        .ts-hero-blob--c {
            display: none;
        }
    }

    /* ═══════════════════════════════════════
               TELÉFONO PEQUEÑO
               ═══════════════════════════════════════ */

    @@media (max-width: 390px) {

        .ts-hero {
            min-height: 68vh;
            padding: 3.2rem 0.85rem;
        }

        .ts-kicker {
            font-size: 0.67rem;
        }

        .ts-headline {
            font-size: 2.6rem;
            gap: 0.15em 0.3em;
        }

        .ts-line-wrap {
            width: 90vw;
        }

        .ts-sub {
            font-size: 0.9rem;
        }

        .ts-cta {
            width: 100%;
            max-width: 285px;
            padding: 0.8rem 1.2rem;
            font-size: 0.9rem;
        }

        .ts-cards {
            grid-template-columns: 1fr;
        }

        .ts-card h3 {
            font-size: 1.4rem;
        }
    }

    /* ═══════════════════════════════════════
               PANTALLAS BAJAS
               ═══════════════════════════════════════ */

    @@media (max-height: 700px) and (min-width: 577px) {

        .ts-hero {
            min-height: 620px;
            padding: 3rem 1.5rem;
        }

        .ts-headline {
            font-size: clamp( 3rem, 8vw, 5.5rem );
        }

        .ts-kicker {
            margin-bottom: 0.85rem;
        }

        .ts-line-wrap {
            margin-top: 1rem;
        }

        .ts-sub {
            margin-top: 1rem;
        }

        .ts-ctas {
            margin-top: 1.5rem;
        }
    }

    /* ═══════════════════════════════════════
               MOVIMIENTO REDUCIDO
               ═══════════════════════════════════════ */

    @@media (prefers-reduced-motion: reduce) {

        .ts-kicker,
        .ts-headline .word,
        .ts-sub,
        .ts-ctas .ts-cta,
        .ts-cards .ts-card {
            opacity: 1 !important;
        }

        .ts-hero-decor {
            display: none;
        }
    }

</style>

